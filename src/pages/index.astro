---
import Layout from '../layouts/Layout.astro';
import BuscadorGasolineras from '../components/BuscadorGasolineras.astro';
import CalculadoraViaje from '../components/CalculadoraViaje.astro';
import TendenciaPrecios from '../components/TendenciaPrecios.astro';
import { PROVINCIAS, slugProvincia } from '../lib/gasolineras.js';
import historicoJson from '../data/historico.json';

const provinciasOrdenadas = [...PROVINCIAS].sort((a, b) => a.nombre.localeCompare(b.nombre, 'es'));

const historico = historicoJson as {
  fechas: string[];
  nacional: Record<string, (number | null)[]>;
};
const seriesNacional = [
  { id: 'g95', label: 'Gasolina 95', valores: historico.nacional?.g95 ?? [] },
  { id: 'ga', label: 'Diésel', valores: historico.nacional?.ga ?? [] },
];

const title = 'Gasolineras baratas cerca de ti + calculadora | Ahorro al Volante';
const description =
  'Ahorro al Volante es un comparador gratuito de precios de carburantes en España: encuentra la gasolinera más barata cerca de ti (gasolina 95, 98, diésel y GLP, datos oficiales del Ministerio) y calcula cuánto te costará un viaje en coche.';

const faqs = [
  {
    q: '¿Cada cuánto se actualizan los precios?',
    a: 'Las estaciones de servicio están obligadas por ley a comunicar sus precios al Ministerio, y el listado oficial (Geoportal Gasolineras) se actualiza aproximadamente cada 30 minutos. Esta web consulta esos datos en directo cada vez que buscas.',
  },
  {
    q: '¿Cómo encuentro la gasolinera más barata cerca de mí?',
    a: 'Pulsa "Cerca de mí" y permite la ubicación: ordenaremos las gasolineras de tu zona por cercanía, con el precio de cada una en color (verde = barata, rojo = cara). También puedes elegir provincia y filtrar por municipio.',
  },
  {
    q: '¿La gasolina low cost es de peor calidad?',
    a: 'No. Todo el combustible que se vende en España cumple la misma normativa y sale de las mismas refinerías y depósitos logísticos. Las diferencias están en los aditivos propios de cada marca y en los servicios de la estación, no en la calidad base del carburante.',
  },
  {
    q: '¿Cuándo es más barato repostar?',
    a: 'Los precios cambian a diario y cada estación decide los suyos. Como norma general, las gasolineras de hipermercados y las automatizadas (low cost) son las más baratas de cada zona, y conviene evitar repostar en autopistas y justo antes de puentes u operaciones salida.',
  },
  {
    q: '¿Por qué la misma marca tiene precios distintos en cada gasolinera?',
    a: 'Porque cada estación fija su precio según sus costes, la competencia de la zona y su política comercial. Por eso merece la pena comparar: entre gasolineras de una misma ciudad puede haber más de 20 céntimos por litro de diferencia.',
  },
  {
    q: '¿Qué hacéis con mi ubicación?',
    a: 'Nada: solo se usa dentro de tu navegador para calcular la distancia a cada gasolinera y ordenarlas por cercanía. No se envía ni se guarda en ningún servidor.',
  },
];

const siteFallback = 'https://ahorroalvolante.es';
const siteUrl = (Astro.site ?? new URL(siteFallback)).href.replace(/\/$/, '');

const jsonLd = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'WebSite',
      '@id': `${siteUrl}/#website`,
      name: 'Ahorro al Volante',
      alternateName: 'AhorroAlVolante.es',
      url: `${siteUrl}/`,
      description,
      inLanguage: 'es-ES',
      publisher: { '@id': `${siteUrl}/#organizacion` },
    },
    {
      '@type': 'Organization',
      '@id': `${siteUrl}/#organizacion`,
      name: 'Ahorro al Volante',
      url: `${siteUrl}/`,
      description,
      logo: { '@type': 'ImageObject', url: `${siteUrl}/icon-512.png`, width: 512, height: 512 },
      parentOrganization: { '@type': 'Organization', name: 'Rosas Web Studio' },
    },
    {
      '@type': 'WebApplication',
      '@id': `${siteUrl}/#app`,
      name: 'Buscador de gasolineras baratas',
      url: `${siteUrl}/`,
      description,
      applicationCategory: 'UtilitiesApplication',
      operatingSystem: 'Web',
      inLanguage: 'es-ES',
      isAccessibleForFree: true,
      isPartOf: { '@id': `${siteUrl}/#website` },
      publisher: { '@id': `${siteUrl}/#organizacion` },
      offers: { '@type': 'Offer', price: '0', priceCurrency: 'EUR' },
      featureList: [
        'Precios de hoy de gasolina 95, 98, diésel, diésel premium y GLP',
        'Gasolineras ordenadas por precio o por cercanía',
        'Datos oficiales del Ministerio actualizados cada 30 minutos',
        'Cómo llegar a cada gasolinera con un clic',
      ],
    },
    {
      '@type': 'FAQPage',
      '@id': `${siteUrl}/#faq`,
      mainEntity: faqs.map((f) => ({
        '@type': 'Question',
        name: f.q,
        acceptedAnswer: { '@type': 'Answer', text: f.a },
      })),
    },
  ],
};

const adBox = 'flex flex-col items-center justify-center rounded-2xl border border-dashed border-borde bg-superficie/60 px-4 py-3 text-center';
---
<Layout title={title} description={description} canonicalPath="/">
  <script type="application/ld+json" slot="head" set:html={JSON.stringify(jsonLd)} />

  <div class="min-h-screen w-full bg-fondo">
    <div class="mx-auto flex max-w-5xl justify-center gap-8">
      <!-- Columna principal -->
      <main class="w-full max-w-2xl">
        <!-- Cabecera -->
        <header class="px-4 pt-6 pb-1">
          <h1 class="text-xl font-bold tracking-tight text-tinta sm:text-2xl">
            La gasolina más barata <span class="text-acento">cerca de ti</span>, hoy
          </h1>
          <p class="mt-2 text-sm leading-relaxed text-suave">
            <strong class="font-semibold text-tinta">Ahorro al Volante</strong> es un comparador gratuito de precios
            de carburantes en España: gasolina 95, 98, diésel y GLP en las gasolineras de tu zona con los
            datos oficiales del Ministerio, y una calculadora de lo que te costará tu próximo viaje.
          </p>
        </header>

        <!-- Conmutador de herramientas -->
        <div class="px-4 pt-4">
          <div class="flex gap-1 rounded-full border border-borde bg-superficie p-1">
            <button id="tab-gas" type="button" data-panel="panel-gasolineras"
              class="flex flex-1 items-center justify-center gap-1.5 rounded-full px-3 py-2 text-sm font-semibold transition-colors bg-amber-500 text-[#0B0D12]">
              <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="h-4 w-4"><circle cx="11" cy="11" r="7"/><path stroke-linecap="round" d="m21 21-4.3-4.3"/></svg>
              Gasolineras baratas
            </button>
            <button id="tab-calc" type="button" data-panel="panel-calculadora"
              class="flex flex-1 items-center justify-center gap-1.5 rounded-full px-3 py-2 text-sm font-semibold transition-colors text-suave">
              <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="h-4 w-4"><rect x="5" y="3" width="14" height="18" rx="2"/><path stroke-linecap="round" d="M9 7h6M8 11h.01M12 11h.01M16 11h.01M8 15h.01M12 15h.01M16 15v-4"/></svg>
              Calculadora
            </button>
          </div>
        </div>

        <div id="panel-gasolineras" class="px-4 pt-4">
          <BuscadorGasolineras />
        </div>

        <div id="panel-calculadora" class="hidden px-4 pt-4">
          <CalculadoraViaje />
          <a href="/calcular-gasto-gasolina/" class="mt-3 flex items-center justify-between gap-3 rounded-2xl border border-borde bg-superficie px-4 py-3 transition-colors hover:border-acento">
            <div>
              <p class="text-sm font-semibold text-tinta">Cuánto cuesta cada viaje, en euros</p>
              <p class="text-xs text-suave">La fórmula, los trayectos habituales y qué dispara el consumo</p>
            </div>
            <span class="shrink-0 text-acento" aria-hidden="true">→</span>
          </a>
        </div>

        <script is:inline>
          (function () {
            var tabs = document.querySelectorAll('[data-panel]');
            var ACTIVE = 'flex flex-1 items-center justify-center gap-1.5 rounded-full px-3 py-2 text-sm font-semibold transition-colors bg-amber-500 text-[#0B0D12]';
            var INACTIVE = 'flex flex-1 items-center justify-center gap-1.5 rounded-full px-3 py-2 text-sm font-semibold transition-colors text-suave';
            function activar(panelId) {
              tabs.forEach(function (t) {
                var on = t.dataset.panel === panelId;
                t.className = on ? ACTIVE : INACTIVE;
                var panel = document.getElementById(t.dataset.panel);
                if (panel) panel.classList.toggle('hidden', !on);
              });
            }
            tabs.forEach(function (t) { t.addEventListener('click', function () { activar(t.dataset.panel); }); });
          })();
        </script>

        {/* CTA de afiliado y hueco de AdSense: OCULTOS hasta tener el enlace real de
            Awin (comparador de seguros de coche) y la cuenta de AdSense aprobada para este
            dominio. Para reactivarlos, quitar este comentario y poner el href real.
        <div class="px-4">
          <a href="#" rel="sponsored nofollow noopener"
            class="mt-4 flex items-center justify-between gap-3 rounded-2xl px-4 py-3.5"
            class="bg-superficie border border-borde">
            <div>
              <p class="text-sm font-semibold text-tinta">¿Pagas de más por tu seguro de coche?</p>
              <p class="text-xs text-suave">Compara aseguradoras en 3 minutos</p>
            </div>
            <span class="shrink-0 rounded-full bg-amber-500 px-3 py-1.5 text-xs font-semibold text-[#0B0D12]">Comparar</span>
          </a>

          <div class={`mt-4 min-h-[100px] w-full ${adBox}`}>
            <span class="text-[10px] font-semibold uppercase tracking-[0.2em] text-tenue">Publicidad</span>
            <span class="mt-1 text-xs text-tenue">Banner responsive (AdSense)</span>
          </div>
        </div>
        */}

        <!-- Comparativas nacionales: responden a "gasolineras low cost" y "dónde está más
             barata la gasolina", de las búsquedas con más volumen del nicho -->
        <section class="px-4 pt-8">
          <h2 class="text-base font-bold text-tinta">Comparativas de toda España</h2>
          <div class="mt-3 grid gap-2">
            <a href="/marcas/" class="flex items-center justify-between gap-3 rounded-2xl border border-borde bg-superficie px-4 py-3.5 transition-colors hover:border-acento">
              <div>
                <p class="text-sm font-semibold text-tinta">¿Qué marca es de verdad más barata?</p>
                <p class="text-xs text-suave">Precio medio de cada cadena, con el dato oficial</p>
              </div>
              <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"
                class="h-4 w-4 shrink-0 text-acento" aria-hidden="true">
                <polyline points="9 18 15 12 9 6" />
              </svg>
            </a>
            <a href="/precios/" class="flex items-center justify-between gap-3 rounded-2xl border border-borde bg-superficie px-4 py-3.5 transition-colors hover:border-acento">
              <div>
                <p class="text-sm font-semibold text-tinta">¿Dónde está más barata la gasolina?</p>
                <p class="text-xs text-suave">Ranking de las 52 provincias y precio por combustible</p>
              </div>
              <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"
                class="h-4 w-4 shrink-0 text-acento" aria-hidden="true">
                <polyline points="9 18 15 12 9 6" />
              </svg>
            </a>
          </div>
        </section>

        <!-- FAQ -->
        <section id="faq" class="px-4 pt-8">
          <h2 class="text-base font-bold text-tinta">Preguntas frecuentes</h2>
          <div class="mt-3 divide-y divide-borde">
            {faqs.map((f) => (
              <details class="group py-3">
                <summary class="flex cursor-pointer list-none items-center justify-between gap-3 text-sm font-medium text-tinta">
                  <span>{f.q}</span>
                  <span class="text-acento transition-transform group-open:rotate-45">+</span>
                </summary>
                <p class="mt-2 text-sm leading-relaxed text-suave">{f.a}</p>
              </details>
            ))}
          </div>
        </section>

        <!-- Texto SEO -->
        <section class="px-4 pt-8">
          <h2 class="text-base font-bold text-tinta">Ahorra cada vez que repostas</h2>
          <div class="mt-2 space-y-3 text-sm leading-relaxed text-suave">
            <p>
              El precio del combustible puede variar más de 20 céntimos por litro entre gasolineras
              de la misma ciudad. En un depósito de 50 litros, eso son más de 10 euros de diferencia
              en cada repostaje: comparar antes de echar gasolina es de los ahorros más fáciles que
              existen.
            </p>
            <p>
              Esta web usa el listado oficial de precios que todas las estaciones de España están
              obligadas a comunicar al Ministerio (Geoportal Gasolineras), así que ves los mismos
              datos que maneja la administración, sin registros y al momento.
            </p>
          </div>
        </section>

        <TendenciaPrecios ambito="España" fechas={historico.fechas} series={seriesNacional} />

        <!-- Provincias (enlazado interno hacia las páginas con precios de cada provincia) -->
        <section class="px-4 pt-8">
          <h2 class="text-base font-bold text-tinta">Gasolineras baratas por provincia</h2>
          <p class="mt-2 text-sm leading-relaxed text-suave">
            Consulta las estaciones más baratas, el precio medio y los municipios donde mejor sale
            repostar en cada provincia.
          </p>
          <div class="mt-3 flex flex-wrap gap-x-3 gap-y-1.5">
            {provinciasOrdenadas.map((p) => (
              <a href={`/gasolineras-baratas/${slugProvincia(p)}/`}
                class="text-xs text-suave hover:text-acento">{p.nombre}</a>
            ))}
          </div>
        </section>

        <!-- Footer -->
        <footer class="px-4 pt-8 pb-8">
          <p class="text-xs leading-relaxed text-tenue">
            Ahorro al Volante es una herramienta informativa. Los precios provienen del listado
            oficial del Ministerio (Geoportal Gasolineras) y pueden variar respecto al surtidor
            en el momento del repostaje. Tu ubicación solo se usa en tu navegador para ordenar
            por cercanía. No es asesoramiento de ningún tipo.
          </p>
          <div class="mt-4 flex flex-wrap gap-x-4 gap-y-1 text-xs">
            <a href="/guias/" class="text-suave hover:text-acento">Guías</a>
            <a href="/quienes-somos" class="text-suave hover:text-acento">Quiénes somos</a>
            <a href="/contacto" class="text-suave hover:text-acento">Contacto</a>
            <a href="/aviso-legal" class="text-suave hover:text-acento">Aviso legal</a>
            <a href="/privacidad" class="text-suave hover:text-acento">Privacidad</a>
            <a href="/cookies" class="text-suave hover:text-acento">Cookies</a>
          </div>
          <p class="mt-3 text-xs text-tenue">© {new Date().getFullYear()} Ahorro al Volante</p>
        </footer>
      </main>

      {/* Anuncio lateral fijo (solo escritorio): OCULTO hasta tener AdSense aprobado.
          Al reactivarlo, sustituir el marcador por la unidad real <ins class="adsbygoogle">.
      <aside class="hidden shrink-0 pt-7 pr-4 lg:block" style="width:300px;">
        <div class={`sticky top-6 min-h-[600px] w-[300px] ${adBox}`}>
          <span class="text-[10px] font-semibold uppercase tracking-[0.2em] text-tenue">Publicidad</span>
          <span class="mt-1 text-xs text-tenue">Rascacielos 300x600 (fijo)</span>
        </div>
      </aside>
      */}
    </div>
  </div>
</Layout>
