---
// Ficha de una marca de gasolinera: qué precio medio tiene de verdad, cuánto se aparta de
// la media nacional, dónde está y cuáles son sus estaciones más baratas de España.
// Captura las búsquedas de marca ("precio Repsol", "¿es cara Ballenoil?") con dato real.
import Layout from '../../layouts/Layout.astro';
import { COMBUSTIBLES } from '../../lib/gasolineras.js';
import { resumenPorMarca } from '../../lib/datos-build.js';

export async function getStaticPaths() {
  const { fecha, nacional, marcas, totalEstaciones } = await resumenPorMarca();
  const conG95 = marcas.filter((m) => m.combustibles.g95);
  return marcas.map((marca) => {
    const pos = conG95.findIndex((m) => m.slug === marca.slug);
    return {
      params: { marca: marca.slug },
      props: {
        marca,
        nacional,
        fecha,
        totalEstaciones,
        // Puesto en el ranking de precio, y las vecinas para poder navegar entre marcas.
        posicion: pos >= 0 ? pos + 1 : null,
        deCuantas: conG95.length,
        masBarata: conG95[0] ?? null,
        otras: marcas
          .filter((m) => m.slug !== marca.slug)
          .sort((a, b) => b.total - a.total)
          .slice(0, 12)
          .map((m) => ({ nombre: m.nombre, slug: m.slug })),
      },
    };
  });
}

interface Estacion { rotulo: string; dir: string; muni: string; horario: string; p: Record<string, number | null> }
interface Stats { n: number; media: number; min: number; max: number; vsNacional: number | null }
interface Marca {
  nombre: string; slug: string; total: number;
  combustibles: Record<string, Stats | null>;
  provincias: { nombre: string; slug: string; n: number }[];
  baratas: Estacion[];
}

interface Props {
  marca: Marca;
  nacional: Record<string, { n: number; media: number } | null>;
  fecha: string;
  totalEstaciones: number;
  posicion: number | null;
  deCuantas: number;
  masBarata: Marca | null;
  otras: { nombre: string; slug: string }[];
}

const { marca, nacional, fecha, posicion, deCuantas, masBarata, otras } = Astro.props;

const p3 = (v: number) => v.toLocaleString('es-ES', { minimumFractionDigits: 3, maximumFractionDigits: 3 });
const p2 = (v: number) => v.toLocaleString('es-ES', { minimumFractionDigits: 2, maximumFractionDigits: 2 });
const cent = (v: number) => `${v > 0 ? '+' : ''}${(v * 100).toLocaleString('es-ES', { maximumFractionDigits: 1 })}`;

const DEPOSITO = 55;
const g95 = marca.combustibles.g95;
const dia = fecha ? fecha.split(' ')[0] : '';

// Combustible de referencia para la conclusion en euros. La gasolina 95 es la que permite
// comparar cadenas entre si, pero hay redes que no la despachan (IDS y similares, orientadas
// a gasoleo). Sin esto esas paginas se quedaban en una tabla de medias sin decir si la marca
// sale cara o barata, que es la unica pregunta que trae aqui al lector.
const refId = marca.combustibles.g95
  ? 'g95'
  : (COMBUSTIBLES.map((c) => c.id)
      .filter((id) => marca.combustibles[id])
      .sort((a, b) => marca.combustibles[b]!.n - marca.combustibles[a]!.n)[0] ?? null);
const ref = refId ? marca.combustibles[refId] : null;
const refLabel = refId ? COMBUSTIBLES.find((c) => c.id === refId)!.label : null;
const refBarata = ref ? ref.vsNacional !== null && ref.vsNacional < 0 : null;
const refDeposito = ref?.vsNacional != null ? Math.abs(ref.vsNacional) * DEPOSITO : 0;

// ¿Barata o cara? Lo dice el dato, no una etiqueta puesta a mano.
const esBarata = g95 ? g95.vsNacional < 0 : null;
const difDeposito = g95?.vsNacional != null ? Math.abs(g95.vsNacional) * DEPOSITO : 0;

const title = g95
  ? `${marca.nombre}: precio medio de la gasolina y el diésel (${dia})`
  : `${marca.nombre}: precios y estaciones en España`;
const description = g95
  ? `${marca.nombre} tiene la gasolina 95 a ${p3(g95.media)} €/L de media en sus ${marca.total} estaciones, ${cent(g95.vsNacional)} céntimos ${esBarata ? 'por debajo' : 'por encima'} de la media nacional. Datos oficiales del Ministerio.`
  : `Precios medios y red de estaciones de ${marca.nombre} en España, con datos oficiales del Ministerio.`;

const rutaCanonica = `/marcas/${marca.slug}/`;
const siteUrl = (Astro.site ?? new URL('https://ahorroalvolante.es')).href.replace(/\/$/, '');

const faqs: { q: string; a: string }[] = [];
if (g95) {
  faqs.push({
    q: `¿Es cara ${marca.nombre}?`,
    a: esBarata
      ? `Está por debajo de la media. Su gasolina 95 cuesta ${p3(g95.media)} €/L de media, ${cent(g95.vsNacional)} céntimos menos que la media nacional (${p3(nacional.g95!.media)} €/L). En un depósito de ${DEPOSITO} litros son unos ${p2(difDeposito)} € de ahorro. Ocupa el puesto ${posicion} de ${deCuantas} cadenas, de más barata a más cara.`
      : `Está por encima de la media. Su gasolina 95 cuesta ${p3(g95.media)} €/L de media, ${cent(g95.vsNacional)} céntimos más que la media nacional (${p3(nacional.g95!.media)} €/L), unos ${p2(difDeposito)} € más por depósito de ${DEPOSITO} litros. Ocupa el puesto ${posicion} de ${deCuantas} cadenas, de más barata a más cara.`,
  });
  faqs.push({
    q: `¿Cuánto cuesta llenar el depósito en ${marca.nombre}?`,
    a: `Con su media de ${p3(g95.media)} €/L, llenar ${DEPOSITO} litros de gasolina 95 sale por unos ${p2(g95.media * DEPOSITO)} €. Dentro de la propia cadena hay diferencias: la estación más barata está a ${p3(g95.min)} €/L y la más cara a ${p3(g95.max)} €/L, así que conviene mirar la concreta que tengas cerca.`,
  });
}
if (!g95 && ref && refLabel) {
  faqs.push({
    q: `¿Es cara ${marca.nombre}?`,
    a: `En ${refLabel}, que es lo que despacha en la mayoría de sus estaciones, su media es de ${p3(ref.media)} €/L, ${cent(ref.vsNacional!)} céntimos ${refBarata ? "por debajo" : "por encima"} de la media nacional. En un depósito de ${DEPOSITO} litros son unos ${p2(refDeposito)} € ${refBarata ? "menos" : "más"} que repostando en una estación de precio medio. No entra en el ranking general de marcas porque ese se hace con la gasolina 95.`,
  });
}
faqs.push({
  q: `¿Cuántas gasolineras ${marca.nombre} hay en España?`,
  a: `${marca.total} en el listado oficial del ${dia}. Donde más tiene es en ${marca.provincias.slice(0, 3).map((p) => `${p.nombre} (${p.n})`).join(', ')}.`,
});
if (g95 && masBarata && masBarata.slug !== marca.slug) {
  faqs.push({
    q: '¿Qué marca sale más barata?',
    a: `Ahora mismo ${masBarata.nombre}, con una media de ${p3(masBarata.combustibles.g95!.media)} €/L en gasolina 95. Puedes ver la comparativa completa de todas las cadenas en la página de marcas.`,
  });
}
faqs.push({
  q: '¿De dónde salen estos precios?',
  a: 'Del listado oficial del Ministerio para la Transición Ecológica, que todas las estaciones están obligadas por ley a comunicar. Se actualiza cada 30 minutos aproximadamente y esta página se regenera a diario. No tenemos ninguna relación comercial con la marca.',
});

const grafo: Record<string, unknown>[] = [
  {
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Inicio', item: `${siteUrl}/` },
      { '@type': 'ListItem', position: 2, name: 'Marcas de gasolinera', item: `${siteUrl}/marcas/` },
      { '@type': 'ListItem', position: 3, name: marca.nombre, item: siteUrl + rutaCanonica },
    ],
  },
  {
    '@type': 'FAQPage',
    mainEntity: faqs.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })),
  },
];
const jsonLd = { '@context': 'https://schema.org', '@graph': grafo };

const card = 'rounded-2xl border border-borde bg-superficie p-4';
const colorSegun = (v: number | null) => (v == null ? 'text-tinta' : v < 0 ? 'text-barato' : 'text-acento');
---
<Layout title={title} description={description} canonicalPath={rutaCanonica}>
  <script type="application/ld+json" slot="head" set:html={JSON.stringify(jsonLd)} />

  <div class="min-h-screen w-full bg-fondo">
    <div class="mx-auto flex max-w-5xl justify-center gap-8">
      <main class="w-full max-w-2xl">
        <nav aria-label="Migas de pan" class="px-4 pt-6 text-xs text-tenue">
          <a href="/" class="hover:text-acento">Inicio</a>
          <span class="mx-1.5">/</span>
          <a href="/marcas/" class="hover:text-acento">Marcas</a>
          <span class="mx-1.5">/</span>
          <span class="text-suave">{marca.nombre}</span>
        </nav>

        <header class="px-4 pt-4">
          <h1 class="text-2xl font-bold tracking-tight text-tinta sm:text-3xl">
            Precios de <span class="text-acento">{marca.nombre}</span>
          </h1>
          {g95 ? (
            <p class="mt-3 text-sm leading-relaxed text-suave">
              Sus <strong class="text-tinta">{marca.total} gasolineras</strong> tienen la
              gasolina 95 a <strong class="text-tinta">{p3(g95.media)} €/L</strong> de media,
              {' '}<strong class={colorSegun(g95.vsNacional)}>{cent(g95.vsNacional)} céntimos</strong>
              {' '}{esBarata ? 'por debajo' : 'por encima'} de la media nacional. Son
              {' '}{p2(difDeposito)} € {esBarata ? 'menos' : 'más'} por cada depósito de {DEPOSITO} litros.
            </p>
          ) : (
            <p class="mt-3 text-sm leading-relaxed text-suave">
              {marca.total} estaciones en España. Esta cadena no vende gasolina 95 en la mayoría de
              ellas, así que no entra en la comparativa general de marcas.
            </p>
          )}
          <p class="mt-2 text-xs text-tenue">Datos oficiales del Ministerio · {dia}</p>
        </header>

        {g95 && posicion && (
          <section class="px-4 pt-5">
            <div class={card}>
              <p class="text-xs font-semibold uppercase tracking-wide text-tenue">En el ranking de marcas</p>
              <p class="mt-1 text-lg font-bold text-tinta">
                Puesto <span class={colorSegun(g95.vsNacional)}>{posicion}</span> de {deCuantas}
              </p>
              <p class="text-xs text-tenue">de la más barata a la más cara, en gasolina 95</p>
              <a href="/marcas/" class="mt-2 inline-block text-xs font-semibold text-acento hover:underline">Ver la comparativa completa →</a>
            </div>
          </section>
        )}

        <!-- Precio por combustible -->
        <section class="px-4 pt-6">
          <h2 class="text-base font-bold text-tinta">Precio medio por combustible</h2>
          <div class="mt-3 overflow-hidden rounded-2xl border border-borde bg-superficie">
            {COMBUSTIBLES.map((c) => {
              const s = marca.combustibles[c.id];
              if (!s) return null;
              return (
                <div class="border-b border-borde px-4 py-3 last:border-0">
                  <div class="flex items-baseline justify-between gap-3">
                    <p class="text-sm font-semibold text-tinta">{c.label}</p>
                    <p class="shrink-0 font-mono text-base font-bold text-tinta">{p3(s.media)} <span class="text-xs text-tenue">€/L</span></p>
                  </div>
                  <p class="mt-1 text-xs text-tenue">
                    {s.n} {s.n === 1 ? 'estación' : 'estaciones'} · de {p3(s.min)} a {p3(s.max)} €/L
                    {s.vsNacional != null && (
                      <> · <span class={colorSegun(s.vsNacional)}>{cent(s.vsNacional)} cent</span> frente a la media nacional</>
                    )}
                  </p>
                </div>
              );
            })}
          </div>
        </section>

        <!-- Sus estaciones más baratas -->
        {marca.baratas.length > 0 && (
          <section class="px-4 pt-8">
            <h2 class="text-base font-bold text-tinta">Las {marca.nombre} más baratas de España</h2>
            <p class="mt-1 text-xs text-tenue">Por precio de la gasolina 95, dentro de esta cadena.</p>
            <div class="mt-3 overflow-hidden rounded-2xl border border-borde bg-superficie">
              {marca.baratas.map((e, i) => (
                <div class="flex items-start justify-between gap-3 border-b border-borde px-4 py-3 last:border-0">
                  <div class="min-w-0">
                    <p class="text-sm font-medium text-tinta">
                      <span class="mr-1.5 text-xs text-tenue">{i + 1}.</span>{e.muni}
                    </p>
                    <p class="truncate text-xs text-tenue">{e.dir}</p>
                  </div>
                  <p class="shrink-0 font-mono text-sm font-bold text-barato">{p3(e.p.g95!)} €/L</p>
                </div>
              ))}
            </div>
          </section>
        )}

        <!-- Dónde tiene más presencia -->
        {marca.provincias.length > 0 && (
          <section class="px-4 pt-8">
            <h2 class="text-base font-bold text-tinta">Dónde hay más gasolineras {marca.nombre}</h2>
            <div class="mt-3 flex flex-wrap gap-2">
              {marca.provincias.slice(0, 20).map((p) => (
                <a href={`/gasolineras-baratas/${p.slug}/`} class="rounded-lg border border-borde bg-superficie px-3 py-1.5 text-xs font-medium text-suave transition-colors hover:border-acento hover:text-acento">
                  {p.nombre} <span class="text-tenue">({p.n})</span>
                </a>
              ))}
            </div>
          </section>
        )}

        <section class="px-4 pt-8">
          <div class="rounded-2xl border border-aviso-borde bg-aviso p-4">
            <p class="text-sm font-semibold text-acento">Esto es una media, no el precio de tu gasolinera</p>
            <p class="mt-1.5 text-sm leading-relaxed text-suave">
              Dentro de {marca.nombre} hay {g95 ? `${p3(g95.min)} €/L en la más barata y ${p3(g95.max)} €/L en la más cara` : 'diferencias importantes de una estación a otra'}:
              cada estación fija su precio según la zona y la competencia. Mira las que tienes cerca
              antes de decidir.
            </p>
            <a href="/" class="mt-3 inline-block rounded-lg bg-amber-500 px-4 py-2 text-sm font-semibold text-[#0B0D12] transition-colors hover:bg-amber-400">
              Buscar gasolineras cerca de mí
            </a>
          </div>
        </section>

        <section class="px-4 pt-8">
          <h2 class="text-base font-bold text-tinta">Preguntas frecuentes</h2>
          <div class="mt-3 divide-y divide-borde">
            {faqs.map((f) => (
              <details class="group py-3">
                <summary class="flex cursor-pointer list-none items-center justify-between gap-3 text-sm font-medium text-tinta">
                  <span>{f.q}</span>
                  <span class="text-acento transition-transform group-open:rotate-45">+</span>
                </summary>
                <p class="mt-2 text-sm leading-relaxed text-suave">{f.a}</p>
              </details>
            ))}
          </div>
        </section>

        <section class="px-4 pt-8">
          <h2 class="text-base font-bold text-tinta">Otras marcas</h2>
          <div class="mt-3 flex flex-wrap gap-2">
            {otras.map((m) => (
              <a href={`/marcas/${m.slug}/`} class="rounded-lg border border-borde bg-superficie px-3 py-1.5 text-xs font-medium text-suave transition-colors hover:border-acento hover:text-acento">{m.nombre}</a>
            ))}
          </div>
        </section>

        <footer class="px-4 pt-10 pb-8">
          <p class="text-xs leading-relaxed text-tenue">
            Medias calculadas con el listado oficial de precios del Ministerio para la Transición
            Ecológica y el Reto Demográfico, del {dia}. Los precios los fija libremente cada
            estación y cambian a diario. Página informativa: no tenemos ninguna relación comercial
            con {marca.nombre} ni con ninguna otra marca citada.
          </p>
          <div class="mt-4 flex flex-wrap gap-x-4 gap-y-1 text-xs">
            <a href="/" class="text-suave hover:text-acento">Inicio</a>
            <a href="/marcas/" class="text-suave hover:text-acento">Marcas</a>
            <a href="/aviso-legal" class="text-suave hover:text-acento">Aviso legal</a>
            <a href="/privacidad" class="text-suave hover:text-acento">Privacidad</a>
          </div>
        </footer>
      </main>
    </div>
  </div>
</Layout>
