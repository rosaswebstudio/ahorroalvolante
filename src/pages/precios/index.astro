---
// Panorama nacional de precios: cuánto cuesta cada combustible en España y en qué
// provincias está más barato y más caro.
//
// Intención NACIONAL ("¿dónde está más barata la gasolina en España?"), distinta de la de
// las páginas de provincia, que son locales ("dónde reposto hoy cerca de mí").
import Layout from '../../layouts/Layout.astro';
import { resumenPorCombustible } from '../../lib/datos-build.js';

const { fecha, combustibles, totalEstaciones } = await resumenPorCombustible();

const p3 = (v: number) => v.toLocaleString('es-ES', { minimumFractionDigits: 3, maximumFractionDigits: 3 });
const p2 = (v: number) => v.toLocaleString('es-ES', { minimumFractionDigits: 2, maximumFractionDigits: 2 });
const cent = (v: number) => (v * 100).toLocaleString('es-ES', { maximumFractionDigits: 1 });

const DEPOSITO = 55;
const dia = fecha ? fecha.split(' ')[0] : '';

const g95 = combustibles.find((c) => c.id === 'g95')!;
const diesel = combustibles.find((c) => c.id === 'ga')!;

// El ranking que de verdad se busca: las 10 provincias más baratas y las 10 más caras.
const baratas = g95.provincias.slice(0, 10);
const caras = [...g95.provincias].slice(-10).reverse();
const brecha = g95.provincias.at(-1)!.media - g95.provincias[0].media;

const title = '¿Dónde está más barata la gasolina en España? Precios por provincia';
const description = `Precio medio de la gasolina y el diésel en las 52 provincias, con datos oficiales del Ministerio. Entre la provincia más barata (${g95.provincias[0].nombre}) y la más cara (${g95.provincias.at(-1)!.nombre}) hay ${cent(brecha)} céntimos por litro.`;
const rutaCanonica = '/precios/';
const siteUrl = (Astro.site ?? new URL('https://ahorroalvolante.es')).href.replace(/\/$/, '');

const faqs = [
  {
    q: '¿Por qué la gasolina es más barata en Canarias, Ceuta y Melilla?',
    a: 'Por la fiscalidad, no por el precio del carburante en sí. Canarias no aplica IVA sino IGIC, con un tipo mucho más bajo, y tampoco tiene el mismo Impuesto sobre Hidrocarburos que la Península. Ceuta y Melilla aplican el IPSI en lugar del IVA. Esa diferencia de impuestos es la que explica casi todo el hueco con el resto de España.',
  },
  {
    q: '¿Y por qué Baleares suele ser la más cara?',
    a: 'Porque todo el combustible llega por barco y el coste logístico se traslada al surtidor. A eso se suma que hay menos competencia entre estaciones que en las grandes ciudades peninsulares.',
  },
  {
    q: '¿Cuánto se ahorra repostando en una provincia u otra?',
    a: `Ahora mismo hay ${cent(brecha)} céntimos por litro entre la provincia más barata y la más cara en gasolina 95: unos ${p2(brecha * DEPOSITO)} € por cada depósito de ${DEPOSITO} litros. Solo compensa tenerlo en cuenta si ya vas a pasar por allí; desviarse expresamente gasta más de lo que ahorra.`,
  },
  {
    q: '¿Estos precios incluyen impuestos?',
    a: 'Sí. Son los precios de venta al público que las estaciones comunican al Ministerio, es decir, lo que pagas en el surtidor con todos los impuestos incluidos.',
  },
  {
    q: '¿Cada cuánto se actualizan?',
    a: `El listado oficial se actualiza aproximadamente cada 30 minutos y esta página se regenera a diario. Los datos mostrados son del ${dia}, con ${totalEstaciones.toLocaleString('es-ES')} gasolineras.`,
  },
];

const jsonLd = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'BreadcrumbList',
      itemListElement: [
        { '@type': 'ListItem', position: 1, name: 'Inicio', item: `${siteUrl}/` },
        { '@type': 'ListItem', position: 2, name: 'Precios por provincia', item: siteUrl + rutaCanonica },
      ],
    },
    {
      '@type': 'ItemList',
      name: 'Provincias con la gasolina 95 más barata de España',
      itemListOrder: 'https://schema.org/ItemListOrderAscending',
      numberOfItems: baratas.length,
      itemListElement: baratas.map((p, i) => ({ '@type': 'ListItem', position: i + 1, name: p.nombre })),
    },
    {
      '@type': 'FAQPage',
      mainEntity: faqs.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })),
    },
  ],
};

const card = 'rounded-2xl border border-[#232733] bg-[#14171F] p-4';
---
<Layout title={title} description={description} canonicalPath={rutaCanonica}>
  <script type="application/ld+json" slot="head" set:html={JSON.stringify(jsonLd)} />

  <div class="min-h-screen w-full" style="background-color:#0B0D12;">
    <div class="mx-auto flex max-w-5xl justify-center gap-8">
      <main class="w-full max-w-2xl">
        <nav aria-label="Migas de pan" class="px-4 pt-6 text-xs text-[#5A6070]">
          <a href="/" class="hover:text-amber-400">Inicio</a>
          <span class="mx-1.5">/</span>
          <span class="text-[#8A8F9C]">Precios por provincia</span>
        </nav>

        <header class="px-4 pt-4">
          <h1 class="text-2xl font-bold tracking-tight text-[#ECEAE3] sm:text-3xl">
            ¿Dónde está más barata la <span class="text-amber-400">gasolina</span> en España?
          </h1>
          <p class="mt-3 text-sm leading-relaxed text-[#8A8F9C]">
            Precio medio de cada combustible en las 52 provincias, con el listado oficial del
            Ministerio. Entre <strong class="text-green-400">{g95.provincias[0].nombre}</strong> y
            {' '}<strong class="text-amber-400">{g95.provincias.at(-1)!.nombre}</strong> hay
            {' '}<strong class="text-[#ECEAE3]">{cent(brecha)} céntimos por litro</strong> en gasolina 95.
          </p>
          <p class="mt-2 text-xs text-[#5A6070]">
            {totalEstaciones.toLocaleString('es-ES')} gasolineras · datos del {dia}
          </p>
        </header>

        <!-- Media nacional de cada combustible -->
        <section class="px-4 pt-6">
          <h2 class="text-base font-bold text-[#ECEAE3]">Precio medio en España hoy</h2>
          <div class="mt-3 overflow-hidden rounded-2xl border border-[#232733] bg-[#14171F]">
            {combustibles.map((c) => (
              <a href={`/precios/${c.slug}/`} class="flex items-center justify-between gap-3 border-b border-[#232733] px-4 py-3 transition-colors last:border-0 hover:bg-[#1A1E27]">
                <div class="min-w-0">
                  <p class="text-sm font-semibold text-[#ECEAE3]">{c.label}</p>
                  <p class="text-xs text-[#5A6070]">{c.nacional.n.toLocaleString('es-ES')} estaciones · desde {p3(c.nacional.min)} €/L</p>
                </div>
                <p class="shrink-0 font-mono text-base font-bold text-[#ECEAE3]">{p3(c.nacional.media)} <span class="text-xs text-[#5A6070]">€/L</span></p>
              </a>
            ))}
          </div>
        </section>

        <!-- Ranking de provincias -->
        <section class="px-4 pt-8">
          <h2 class="text-base font-bold text-[#ECEAE3]">Las 10 provincias más baratas</h2>
          <p class="mt-1 text-xs text-[#5A6070]">Media de gasolina 95.</p>
          <div class="mt-3 overflow-hidden rounded-2xl border border-[#232733] bg-[#14171F]">
            {baratas.map((p, i) => (
              <a href={`/gasolineras-baratas/${p.slug}/`} class="flex items-center justify-between gap-3 border-b border-[#232733] px-4 py-2.5 transition-colors last:border-0 hover:bg-[#1A1E27]">
                <p class="text-sm text-[#ECEAE3]"><span class="mr-2 text-xs text-[#5A6070]">{i + 1}.</span>{p.nombre}</p>
                <p class="shrink-0 font-mono text-sm font-bold text-green-400">{p3(p.media)} €/L</p>
              </a>
            ))}
          </div>
        </section>

        <section class="px-4 pt-6">
          <h2 class="text-base font-bold text-[#ECEAE3]">Las 10 más caras</h2>
          <div class="mt-3 overflow-hidden rounded-2xl border border-[#232733] bg-[#14171F]">
            {caras.map((p, i) => (
              <a href={`/gasolineras-baratas/${p.slug}/`} class="flex items-center justify-between gap-3 border-b border-[#232733] px-4 py-2.5 transition-colors last:border-0 hover:bg-[#1A1E27]">
                <p class="text-sm text-[#ECEAE3]"><span class="mr-2 text-xs text-[#5A6070]">{i + 1}.</span>{p.nombre}</p>
                <p class="shrink-0 font-mono text-sm font-bold text-amber-400">{p3(p.media)} €/L</p>
              </a>
            ))}
          </div>
        </section>

        <section class="px-4 pt-8">
          <div class="rounded-2xl border p-4" style="border-color:#3A3320;background-color:#1A170E;">
            <p class="text-sm font-semibold text-amber-400">No cruces media España por 3 céntimos</p>
            <p class="mt-1.5 text-sm leading-relaxed text-[#8A8F9C]">
              Estas diferencias son útiles si ya vas a pasar por esa provincia, pero desviarse a
              propósito casi nunca compensa: cada kilómetro extra también gasta. Con un coche que
              haga 6 L/100 km, un desvío de 20 km ida y vuelta se come unos {p2(2.4 * g95.nacional.media)} €,
              más de lo que se ahorra en un depósito entero por la diferencia entre provincias vecinas.
            </p>
            <a href="/" class="mt-3 inline-block rounded-lg bg-amber-500 px-4 py-2 text-sm font-semibold text-[#0B0D12] transition-colors hover:bg-amber-400">
              Ver las más baratas cerca de mí
            </a>
          </div>
        </section>

        <section class="px-4 pt-8">
          <h2 class="text-base font-bold text-[#ECEAE3]">Precio por combustible</h2>
          <div class="mt-3 grid gap-2 sm:grid-cols-2">
            {combustibles.map((c) => (
              <a href={`/precios/${c.slug}/`} class="flex items-center justify-between gap-2 rounded-xl border border-[#232733] bg-[#14171F] px-3 py-2.5 text-sm text-[#ECEAE3] transition-colors hover:border-amber-400">
                <span>Precio {c.de}</span>
                <span class="shrink-0 font-mono text-xs text-[#5A6070]">{p3(c.nacional.media)}</span>
              </a>
            ))}
          </div>
        </section>

        <section class="px-4 pt-8">
          <h2 class="text-base font-bold text-[#ECEAE3]">Preguntas frecuentes</h2>
          <div class="mt-3 divide-y divide-[#232733]">
            {faqs.map((f) => (
              <details class="group py-3">
                <summary class="flex cursor-pointer list-none items-center justify-between gap-3 text-sm font-medium text-[#ECEAE3]">
                  <span>{f.q}</span>
                  <span class="text-amber-400 transition-transform group-open:rotate-45">+</span>
                </summary>
                <p class="mt-2 text-sm leading-relaxed text-[#8A8F9C]">{f.a}</p>
              </details>
            ))}
          </div>
        </section>

        <footer class="px-4 pt-10 pb-8">
          <p class="text-xs leading-relaxed text-[#5A6070]">
            Medias calculadas con el listado oficial de precios del Ministerio para la Transición
            Ecológica y el Reto Demográfico, del {dia}. Son precios de venta al público, con
            impuestos incluidos, y cambian a diario.
          </p>
          <div class="mt-4 flex flex-wrap gap-x-4 gap-y-1 text-xs">
            <a href="/" class="text-[#8A8F9C] hover:text-amber-400">Inicio</a>
            <a href="/marcas/" class="text-[#8A8F9C] hover:text-amber-400">Marcas</a>
            <a href="/aviso-legal" class="text-[#8A8F9C] hover:text-amber-400">Aviso legal</a>
            <a href="/privacidad" class="text-[#8A8F9C] hover:text-amber-400">Privacidad</a>
          </div>
        </footer>
      </main>
    </div>
  </div>
</Layout>
