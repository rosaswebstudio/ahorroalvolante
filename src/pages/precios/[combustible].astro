---
// Ficha de un combustible: precio medio en España, ranking completo de las 52 provincias,
// qué marcas lo tienen más barato y las estaciones más baratas del país.
//
// Captura las búsquedas de tipo "precio del diésel", "gasolina 95 hoy", "GLP barato", que
// son nacionales y no las resuelve una página de provincia.
import Layout from '../../layouts/Layout.astro';
import { resumenPorCombustible } from '../../lib/datos-build.js';

export async function getStaticPaths() {
  const { fecha, combustibles, totalEstaciones } = await resumenPorCombustible();
  return combustibles.map((c) => ({
    params: { combustible: c.slug },
    props: {
      c,
      fecha,
      totalEstaciones,
      otros: combustibles.filter((x) => x.slug !== c.slug).map((x) => ({ slug: x.slug, label: x.label, titulo: x.titulo, de: x.de, media: x.nacional.media })),
    },
  }));
}

interface Estacion { rotulo: string; dir: string; muni: string; p: Record<string, number | null> }
interface Prov { nombre: string; slug: string; n: number; media: number; min: number }
interface MarcaComb { nombre: string; slug: string; n: number; media: number }

interface Props {
  // `titulo` = "el diésel", `de` = "del diésel", `barato` = "barato"/"barata" para concordar.
  c: {
    id: string; label: string; slug: string; titulo: string; de: string; barato: string;
    nacional: { n: number; media: number; min: number; max: number };
    provincias: Prov[];
    marcas: MarcaComb[];
    baratas: Estacion[];
  };
  fecha: string;
  totalEstaciones: number;
  otros: { slug: string; label: string; titulo: string; de: string; media: number }[];
}

const { c, fecha, otros } = Astro.props;

const p3 = (v: number) => v.toLocaleString('es-ES', { minimumFractionDigits: 3, maximumFractionDigits: 3 });
const p2 = (v: number) => v.toLocaleString('es-ES', { minimumFractionDigits: 2, maximumFractionDigits: 2 });
const cent = (v: number) => (v * 100).toLocaleString('es-ES', { maximumFractionDigits: 1 });

const DEPOSITO = 55;
const dia = fecha ? fecha.split(' ')[0] : '';

const masBarata = c.provincias[0];
const masCara = c.provincias[c.provincias.length - 1];
const brecha = masCara.media - masBarata.media;
const deposito = c.nacional.media * DEPOSITO;

// Escala de la barra del ranking de provincias.
const anchoBarra = (v: number) => 10 + Math.round(((v - masBarata.media) / (brecha || 1)) * 90);

const title = `Precio ${c.de} hoy en España, provincia a provincia`;
const description = `${c.label} a ${p3(c.nacional.media)} €/L de media en España. Ranking de las 52 provincias, marcas más baratas y las gasolineras con el precio más bajo del país. Datos oficiales del ${dia}.`;
const rutaCanonica = `/precios/${c.slug}/`;
const siteUrl = (Astro.site ?? new URL('https://ahorroalvolante.es')).href.replace(/\/$/, '');

const faqs = [
  {
    q: `¿A cuánto está ${c.titulo} hoy?`,
    a: `A ${p3(c.nacional.media)} € por litro de media en España, según el listado oficial del ${dia}. La estación más barata del país lo tiene a ${p3(c.nacional.min)} €/L y la más cara a ${p3(c.nacional.max)} €/L. Llenar ${DEPOSITO} litros al precio medio sale por unos ${p2(deposito)} €.`,
  },
  {
    q: `¿En qué provincia está más ${c.barato} ${c.titulo}?`,
    a: `En ${masBarata.nombre}, con una media de ${p3(masBarata.media)} €/L. La más cara es ${masCara.nombre}, a ${p3(masCara.media)} €/L: ${cent(brecha)} céntimos por litro de diferencia, unos ${p2(brecha * DEPOSITO)} € por depósito.`,
  },
  ...(c.marcas.length
    ? [{
        q: `¿Qué marca tiene ${c.titulo} más ${c.barato}?`,
        a: `${c.marcas[0].nombre}, con una media de ${p3(c.marcas[0].media)} €/L en las ${c.marcas[0].n} estaciones suyas que lo venden. Solo se comparan cadenas con al menos 20 estaciones que ofrezcan este combustible.`,
      }]
    : []),
  {
    q: '¿Estos precios llevan impuestos?',
    a: 'Sí. Son los precios de venta al público que las estaciones están obligadas a comunicar al Ministerio, es decir, lo que pagas en el surtidor.',
  },
];

const jsonLd = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'BreadcrumbList',
      itemListElement: [
        { '@type': 'ListItem', position: 1, name: 'Inicio', item: `${siteUrl}/` },
        { '@type': 'ListItem', position: 2, name: 'Precios por provincia', item: `${siteUrl}/precios/` },
        { '@type': 'ListItem', position: 3, name: c.label, item: siteUrl + rutaCanonica },
      ],
    },
    {
      '@type': 'ItemList',
      name: `Provincias con ${c.titulo} más ${c.barato}`,
      itemListOrder: 'https://schema.org/ItemListOrderAscending',
      numberOfItems: Math.min(10, c.provincias.length),
      itemListElement: c.provincias.slice(0, 10).map((p, i) => ({ '@type': 'ListItem', position: i + 1, name: p.nombre })),
    },
    {
      '@type': 'FAQPage',
      mainEntity: faqs.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })),
    },
  ],
};

const card = 'rounded-2xl border border-[#232733] bg-[#14171F] p-4';
---
<Layout title={title} description={description} canonicalPath={rutaCanonica}>
  <script type="application/ld+json" slot="head" set:html={JSON.stringify(jsonLd)} />

  <div class="min-h-screen w-full" style="background-color:#0B0D12;">
    <div class="mx-auto flex max-w-5xl justify-center gap-8">
      <main class="w-full max-w-2xl">
        <nav aria-label="Migas de pan" class="px-4 pt-6 text-xs text-[#5A6070]">
          <a href="/" class="hover:text-amber-400">Inicio</a>
          <span class="mx-1.5">/</span>
          <a href="/precios/" class="hover:text-amber-400">Precios</a>
          <span class="mx-1.5">/</span>
          <span class="text-[#8A8F9C]">{c.label}</span>
        </nav>

        <header class="px-4 pt-4">
          <h1 class="text-2xl font-bold tracking-tight text-[#ECEAE3] sm:text-3xl">
            Precio <span class="text-amber-400">{c.de}</span> hoy
          </h1>
          <p class="mt-3 text-sm leading-relaxed text-[#8A8F9C]">
            Media de <strong class="text-[#ECEAE3]">{p3(c.nacional.media)} €/L</strong> en las
            {' '}{c.nacional.n.toLocaleString('es-ES')} gasolineras de España que lo venden.
            Llenar {DEPOSITO} litros sale por unos <strong class="text-[#ECEAE3]">{p2(deposito)} €</strong>.
          </p>
          <p class="mt-2 text-xs text-[#5A6070]">Listado oficial del Ministerio · {dia}</p>
        </header>

        <section class="grid grid-cols-3 gap-3 px-4 pt-5">
          <div class={card}>
            <p class="text-xs font-semibold uppercase tracking-wide text-[#5A6070]">Más barato</p>
            <p class="mt-1 font-mono text-base font-bold text-green-400">{p3(c.nacional.min)}</p>
            <p class="text-xs text-[#5A6070]">€/L</p>
          </div>
          <div class={card}>
            <p class="text-xs font-semibold uppercase tracking-wide text-[#5A6070]">Media</p>
            <p class="mt-1 font-mono text-base font-bold text-[#ECEAE3]">{p3(c.nacional.media)}</p>
            <p class="text-xs text-[#5A6070]">€/L</p>
          </div>
          <div class={card}>
            <p class="text-xs font-semibold uppercase tracking-wide text-[#5A6070]">Más caro</p>
            <p class="mt-1 font-mono text-base font-bold text-amber-400">{p3(c.nacional.max)}</p>
            <p class="text-xs text-[#5A6070]">€/L</p>
          </div>
        </section>

        <!-- Ranking completo de provincias -->
        <section class="px-4 pt-8">
          <h2 class="text-base font-bold text-[#ECEAE3]">Precio {c.de} por provincia</h2>
          <p class="mt-1 text-xs text-[#5A6070]">
            Las {c.provincias.length} provincias con datos, de más barata a más cara. Pincha para ver sus gasolineras.
          </p>
          <div class="mt-3 overflow-hidden rounded-2xl border border-[#232733] bg-[#14171F]">
            {c.provincias.map((p, i) => (
              <a href={`/gasolineras-baratas/${p.slug}/`} class="block border-b border-[#232733] px-4 py-2.5 transition-colors last:border-0 hover:bg-[#1A1E27]">
                <div class="flex items-baseline justify-between gap-3">
                  <p class="text-sm text-[#ECEAE3]"><span class="mr-2 text-xs text-[#5A6070]">{i + 1}.</span>{p.nombre}</p>
                  <p class="shrink-0 font-mono text-sm font-bold text-[#ECEAE3]">{p3(p.media)} €/L</p>
                </div>
                <div class="mt-1.5 h-1 w-full overflow-hidden rounded-full bg-[#0B0D12]">
                  <div class={`h-full rounded-full ${p.media < c.nacional.media ? 'bg-green-500' : 'bg-amber-500'}`} style={`width:${anchoBarra(p.media)}%`}></div>
                </div>
                <p class="mt-1 text-xs text-[#5A6070]">{p.n} estaciones · la más barata a {p3(p.min)} €/L</p>
              </a>
            ))}
          </div>
        </section>

        <!-- Marcas -->
        {c.marcas.length > 0 && (
          <section class="px-4 pt-8">
            <h2 class="text-base font-bold text-[#ECEAE3]">Marcas con {c.titulo} más {c.barato}</h2>
            <p class="mt-1 text-xs text-[#5A6070]">Cadenas con al menos 20 estaciones que lo venden.</p>
            <div class="mt-3 overflow-hidden rounded-2xl border border-[#232733] bg-[#14171F]">
              {c.marcas.slice(0, 12).map((m, i) => (
                <a href={`/marcas/${m.slug}/`} class="flex items-center justify-between gap-3 border-b border-[#232733] px-4 py-2.5 transition-colors last:border-0 hover:bg-[#1A1E27]">
                  <div class="min-w-0">
                    <p class="text-sm text-[#ECEAE3]"><span class="mr-2 text-xs text-[#5A6070]">{i + 1}.</span>{m.nombre}</p>
                    <p class="text-xs text-[#5A6070]">{m.n} estaciones</p>
                  </div>
                  <p class={`shrink-0 font-mono text-sm font-bold ${m.media < c.nacional.media ? 'text-green-400' : 'text-amber-400'}`}>{p3(m.media)} €/L</p>
                </a>
              ))}
            </div>
            <a href="/marcas/" class="mt-2 inline-block text-xs font-semibold text-amber-400 hover:underline">Ver la comparativa completa de marcas →</a>
          </section>
        )}

        <!-- Estaciones más baratas de España -->
        <section class="px-4 pt-8">
          <h2 class="text-base font-bold text-[#ECEAE3]">Las gasolineras con {c.titulo} más {c.barato} de España</h2>
          <div class="mt-3 overflow-hidden rounded-2xl border border-[#232733] bg-[#14171F]">
            {c.baratas.map((e, i) => (
              <div class="flex items-start justify-between gap-3 border-b border-[#232733] px-4 py-3 last:border-0">
                <div class="min-w-0">
                  <p class="text-sm font-medium text-[#ECEAE3]">
                    <span class="mr-1.5 text-xs text-[#5A6070]">{i + 1}.</span>{e.rotulo}
                  </p>
                  <p class="truncate text-xs text-[#5A6070]">{e.muni} · {e.dir}</p>
                </div>
                <p class="shrink-0 font-mono text-sm font-bold text-green-400">{p3(e.p[c.id]!)} €/L</p>
              </div>
            ))}
          </div>
          <p class="mt-2 text-xs text-[#5A6070]">
            Son las más baratas del país, pero probablemente no te pillen cerca.
            <a href="/" class="ml-1 font-semibold text-amber-400 hover:underline">Busca las de tu zona →</a>
          </p>
        </section>

        <section class="px-4 pt-8">
          <h2 class="text-base font-bold text-[#ECEAE3]">Preguntas frecuentes</h2>
          <div class="mt-3 divide-y divide-[#232733]">
            {faqs.map((f) => (
              <details class="group py-3">
                <summary class="flex cursor-pointer list-none items-center justify-between gap-3 text-sm font-medium text-[#ECEAE3]">
                  <span>{f.q}</span>
                  <span class="text-amber-400 transition-transform group-open:rotate-45">+</span>
                </summary>
                <p class="mt-2 text-sm leading-relaxed text-[#8A8F9C]">{f.a}</p>
              </details>
            ))}
          </div>
        </section>

        <section class="px-4 pt-8">
          <h2 class="text-base font-bold text-[#ECEAE3]">Otros combustibles</h2>
          <div class="mt-3 grid gap-2 sm:grid-cols-2">
            {otros.map((o) => (
              <a href={`/precios/${o.slug}/`} class="flex items-center justify-between gap-2 rounded-xl border border-[#232733] bg-[#14171F] px-3 py-2.5 text-sm text-[#ECEAE3] transition-colors hover:border-amber-400">
                <span>Precio {o.de}</span>
                <span class="shrink-0 font-mono text-xs text-[#5A6070]">{p3(o.media)}</span>
              </a>
            ))}
          </div>
        </section>

        <footer class="px-4 pt-10 pb-8">
          <p class="text-xs leading-relaxed text-[#5A6070]">
            Medias calculadas con el listado oficial de precios del Ministerio para la Transición
            Ecológica y el Reto Demográfico, del {dia}. Precios de venta al público con impuestos
            incluidos; los fija libremente cada estación y cambian a diario.
          </p>
          <div class="mt-4 flex flex-wrap gap-x-4 gap-y-1 text-xs">
            <a href="/" class="text-[#8A8F9C] hover:text-amber-400">Inicio</a>
            <a href="/precios/" class="text-[#8A8F9C] hover:text-amber-400">Precios</a>
            <a href="/marcas/" class="text-[#8A8F9C] hover:text-amber-400">Marcas</a>
            <a href="/aviso-legal" class="text-[#8A8F9C] hover:text-amber-400">Aviso legal</a>
          </div>
        </footer>
      </main>
    </div>
  </div>
</Layout>
