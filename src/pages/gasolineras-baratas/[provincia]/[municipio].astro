---
// Página por pueblo/ciudad. Se genera en el build para los municipios con al menos
// MIN_ESTACIONES_MUNICIPIO gasolineras, con datos reales de ese municipio (estaciones,
// precios, media propia y comparación con su provincia), no una plantilla vacía.
import Layout from '../../../layouts/Layout.astro';
import { COMBUSTIBLES } from '../../../lib/gasolineras.js';
import { resumenPorMunicipio } from '../../../lib/datos-build.js';

export async function getStaticPaths() {
  const municipios = await resumenPorMunicipio();
  return municipios.map((datos) => ({
    params: { provincia: datos.provSlug, municipio: datos.muniSlug },
    props: { datos },
  }));
}

interface Estacion {
  rotulo: string;
  dir: string;
  muni: string;
  horario: string;
  lat: number | null;
  lng: number | null;
  p: Record<string, number | null>;
}

interface ResumenCombustible {
  n: number;
  min: number;
  max: number;
  media: number;
  baratas: Estacion[];
}

interface Props {
  datos: {
    prov: { id: string; nombre: string };
    provSlug: string;
    muniNombre: string;
    muniSlug: string;
    fecha: string;
    total: number;
    combustibles: Record<string, ResumenCombustible | null>;
    mediaProvinciaG95: number | null;
    cercanos: { nombre: string; slug: string | null; minG95: number; km: number }[];
    minAqui: number | null;
    hermanos: { nombre: string; slug: string }[];
  };
}

const { datos } = Astro.props;
const { prov, provSlug, muniNombre, fecha, total, combustibles, mediaProvinciaG95, hermanos, cercanos, minAqui } = datos;


const g95 = combustibles.g95;
const ga = combustibles.ga;

const p3 = (n: number | null) => (n === null ? '-' : n.toFixed(3).replace('.', ','));
const p2 = (n: number | null) => (n === null ? '-' : n.toFixed(2).replace('.', ','));
const pct = (n: number) => Math.abs(n).toLocaleString('es-ES', { maximumFractionDigits: 1 });
const dia = (fecha || '').split(' ')[0];

// Comparación del pueblo con la media de su provincia: el dato diferenciador.
const difProv = g95 && mediaProvinciaG95 ? (g95.media - mediaProvinciaG95) / mediaProvinciaG95 : null;
const masBarato = difProv !== null && difProv < -0.002;
const masCaro = difProv !== null && difProv > 0.002;

// Deposito de referencia para traducir centimos por litro a euros, que es la unidad en
// la que la gente decide. 55 L es un deposito de turismo medio.
const DEPOSITO = 55;

// Lo que se juega el conductor DENTRO del municipio: diferencia entre la estacion mas
// barata y la mas cara. Es el dato que justifica la pagina, y cambia en cada pueblo.
const horquilla = g95 ? g95.max - g95.min : null;
const ahorroDeposito = horquilla !== null ? horquilla * DEPOSITO : null;

// Municipios cercanos donde el litro sale mas barato que aqui. El umbral de medio
// centimo evita presentar como "mas barato" lo que es la misma cifra con ruido.
const cercanosBaratos = minAqui !== null
  ? cercanos.filter((c) => c.minG95 < minAqui - 0.005)
  : [];
const mejorCercano = cercanosBaratos[0] ?? null;
const ahorroCercano = mejorCercano && minAqui !== null
  ? (minAqui - mejorCercano.minG95) * DEPOSITO
  : null;
const km1 = (n: number) => n.toLocaleString(`es-ES`, { maximumFractionDigits: n < 10 ? 1 : 0 });

const mapa = (e: Estacion) =>
  e.lat && e.lng ? `https://www.google.com/maps/search/?api=1&query=${e.lat},${e.lng}` : null;

const title = `Gasolineras baratas en ${muniNombre} (${prov.nombre}): precios de hoy`;
const description = g95
  ? `Las gasolineras más baratas de ${muniNombre} (${prov.nombre}) hoy: ${total} estaciones con precios oficiales del Ministerio. Gasolina 95 desde ${p3(g95.min)} €/L.`
  : `Precios de las ${total} gasolineras de ${muniNombre} (${prov.nombre}) con datos oficiales del Ministerio.`;

const rutaCanonica = `/gasolineras-baratas/${provSlug}/${datos.muniSlug}/`;
const siteUrl = (Astro.site ?? new URL('https://ahorroalvolante.es')).href.replace(/\/$/, '');

const faqs: { q: string; a: string }[] = [];
if (g95) {
  faqs.push({
    q: `¿Cuál es la gasolinera más barata de ${muniNombre}?`,
    a: `Según el listado oficial del ${dia}, la gasolina 95 más barata de ${muniNombre} está en ${g95.baratas[0].rotulo}, a ${p3(g95.min)} € por litro. Los precios los fija cada estación y cambian a diario.`,
  });
  if (difProv !== null) {
    faqs.push({
      q: `¿Es cara la gasolina en ${muniNombre}?`,
      a: masBarato
        ? `La media de gasolina 95 en ${muniNombre} (${p3(g95.media)} €/L) está por debajo de la media de la provincia de ${prov.nombre} (${p3(mediaProvinciaG95)} €/L), así que repostar aquí sale, de media, algo más barato que en el conjunto de la provincia.`
        : masCaro
          ? `La media de gasolina 95 en ${muniNombre} (${p3(g95.media)} €/L) está por encima de la media de la provincia de ${prov.nombre} (${p3(mediaProvinciaG95)} €/L). Aun así, dentro del propio municipio hay diferencias entre estaciones que conviene comparar.`
          : `La media de gasolina 95 en ${muniNombre} (${p3(g95.media)} €/L) es prácticamente igual que la de la provincia de ${prov.nombre}. Lo que más ahorra es comparar entre las estaciones del propio municipio.`,
    });
  }
}
if (ahorroDeposito !== null && ahorroDeposito >= 2) {
  faqs.push({
    q: `¿Cuánto se ahorra repostando en la gasolinera más barata de ${muniNombre}?`,
    a: `Entre la estación más barata de ${muniNombre} (${p3(g95!.min)} €/L) y la más cara (${p3(g95!.max)} €/L) hay ${p3(horquilla)} € por litro. En un depósito de ${DEPOSITO} litros son ${p2(ahorroDeposito)} € de diferencia por repostaje, sin cambiar de combustible ni de coche: solo eligiendo el surtidor.`,
  });
}
if (mejorCercano && ahorroCercano !== null && ahorroCercano >= 2) {
  faqs.push({
    q: `¿Merece la pena repostar fuera de ${muniNombre}?`,
    a: `A ${km1(mejorCercano.km)} km está ${mejorCercano.nombre}, con gasolina 95 desde ${p3(mejorCercano.minG95)} €/L frente a los ${p3(minAqui)} €/L de ${muniNombre}: unos ${p2(ahorroCercano)} € menos por depósito. Contando la ida y la vuelta el desvío sale a cuenta si ya ibas en esa dirección; si no, gastarías en combustible parte de lo que ahorras.`,
  });
}
faqs.push({
  q: '¿De dónde salen estos precios?',
  a: `De la API oficial del Ministerio para la Transición Ecológica (Geoportal de Gasolineras), que las estaciones están obligadas a comunicar y se actualiza cada 30 minutos aproximadamente. Esta página se regenera a diario; para el precio al minuto, usa el buscador de la portada.`,
});

const grafo: Record<string, unknown>[] = [
  {
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Inicio', item: `${siteUrl}/` },
      { '@type': 'ListItem', position: 2, name: `Gasolineras baratas en ${prov.nombre}`, item: `${siteUrl}/gasolineras-baratas/${provSlug}/` },
      { '@type': 'ListItem', position: 3, name: muniNombre, item: siteUrl + rutaCanonica },
    ],
  },
  {
    '@type': 'FAQPage',
    mainEntity: faqs.map((f) => ({
      '@type': 'Question',
      name: f.q,
      acceptedAnswer: { '@type': 'Answer', text: f.a },
    })),
  },
];
// Lista ordenada de gasolineras por precio, para que Google entienda el ranking.
if (g95) {
  grafo.push({
    '@type': 'ItemList',
    name: `Gasolineras más baratas de ${muniNombre} (gasolina 95)`,
    itemListOrder: 'https://schema.org/ItemListOrderAscending',
    numberOfItems: g95.baratas.length,
    itemListElement: g95.baratas.map((e, i) => ({
      '@type': 'ListItem',
      position: i + 1,
      name: e.rotulo,
    })),
  });
}
const jsonLd = { '@context': 'https://schema.org', '@graph': grafo };

const card = 'rounded-2xl border border-borde bg-superficie p-4';
const colorPrecio = (v: number | null, m: number) =>
  v !== null && v < m ? 'text-barato' : 'text-acento';
---
<Layout title={title} description={description} canonicalPath={rutaCanonica}>
  <script type="application/ld+json" slot="head" set:html={JSON.stringify(jsonLd)} />

  <div class="min-h-screen w-full bg-fondo">
    <div class="mx-auto flex max-w-5xl justify-center gap-8">
      <main class="w-full max-w-2xl">
        <!-- Migas -->
        <nav aria-label="Migas de pan" class="px-4 pt-6 text-xs text-tenue">
          <a href="/" class="hover:text-acento">Inicio</a>
          <span class="mx-1.5">/</span>
          <a href={`/gasolineras-baratas/${provSlug}/`} class="hover:text-acento">{prov.nombre}</a>
          <span class="mx-1.5">/</span>
          <span class="text-suave">{muniNombre}</span>
        </nav>

        <header class="px-4 pt-4">
          <h1 class="text-2xl font-bold tracking-tight text-tinta sm:text-3xl">
            Gasolineras baratas en <span class="text-acento">{muniNombre}</span>
          </h1>
          <p class="mt-3 text-sm leading-relaxed text-suave">
            {g95 ? (
              <>
                {muniNombre} ({prov.nombre}) tiene <strong class="text-tinta">{total} gasolineras</strong>
                {' '}en el listado oficial del Ministerio. La gasolina 95 más barata está a
                {' '}<strong class="text-barato">{p3(g95.min)} €/L</strong> en {g95.baratas[0].rotulo},
                {' '}con una media local de <strong class="text-tinta">{p3(g95.media)} €/L</strong>
                {difProv !== null && (masBarato || masCaro) && (
                  <>
                    , un <strong class={masBarato ? 'text-barato' : 'text-acento'}>{pct(difProv * 100)}%
                    {' '}{masBarato ? 'por debajo' : 'por encima'}</strong> de la media de la provincia.
                  </>
                )}.
              </>
            ) : (
              <>Precios de las {total} gasolineras de {muniNombre} ({prov.nombre}) con datos oficiales del Ministerio.</>
            )}
          </p>
          <p class="mt-2 text-xs text-tenue">Datos oficiales del Ministerio. Actualizado el {fecha}.</p>
        </header>

        {g95 && (
          <>
            <!-- Cifras -->
            <section class="grid grid-cols-2 gap-3 px-4 pt-5">
              <div class={card}>
                <p class="text-xs font-semibold uppercase tracking-wide text-tenue">95 más barata</p>
                <p class="mt-1 text-xl font-bold text-barato">{p3(g95.min)} <span class="text-sm font-semibold text-suave">€/L</span></p>
              </div>
              <div class={card}>
                <p class="text-xs font-semibold uppercase tracking-wide text-tenue">Media 95 local</p>
                <p class="mt-1 text-xl font-bold text-tinta">{p3(g95.media)} <span class="text-sm font-semibold text-suave">€/L</span></p>
              </div>
              <div class={card}>
                <p class="text-xs font-semibold uppercase tracking-wide text-tenue">Media diésel</p>
                <p class="mt-1 text-xl font-bold text-tinta">{ga ? p3(ga.media) : '-'} <span class="text-sm font-semibold text-suave">€/L</span></p>
              </div>
              <div class={card}>
                <p class="text-xs font-semibold uppercase tracking-wide text-tenue">Gasolineras</p>
                <p class="mt-1 text-xl font-bold text-tinta">{total}</p>
              </div>
            </section>

            <!-- Lo que se juega el conductor eligiendo surtidor dentro del pueblo -->
            {ahorroDeposito !== null && ahorroDeposito >= 1 && (
              <section class="px-4 pt-6">
                <div class="rounded-2xl border border-amber-500/30 bg-amber-500/5 p-4">
                  <p class="text-sm leading-relaxed text-suave">
                    Entre la gasolinera más barata de {muniNombre} y la más cara hay
                    <strong class="text-tinta">{p3(horquilla)} € por litro</strong>. En
                    un depósito de {DEPOSITO} litros eso son <strong class="text-barato">{p2(ahorroDeposito)} €</strong>
                    de diferencia en el mismo repostaje, con el mismo combustible.
                  </p>
                </div>
              </section>
            )}

            <!-- Todas las gasolineras del municipio (95) -->
            <section class="px-4 pt-8">
              <h2 class="text-base font-bold text-tinta">
                Gasolineras de {muniNombre} por precio (gasolina 95)
              </h2>
              <ol class="mt-3 divide-y divide-borde rounded-2xl border border-borde bg-superficie">
                {g95.baratas.map((e, i) => (
                  <li class="flex items-center gap-3 px-4 py-3">
                    <span class="w-5 shrink-0 text-sm font-bold text-tenue">{i + 1}</span>
                    <div class="min-w-0 flex-1">
                      <p class="truncate text-sm font-semibold text-tinta">{e.rotulo}</p>
                      {e.dir && <p class="truncate text-xs text-suave">{e.dir}</p>}
                    </div>
                    <div class="shrink-0 text-right">
                      <p class={`text-base font-bold ${colorPrecio(e.p.g95, g95.media)}`}>{p3(e.p.g95)}</p>
                      <p class="text-[10px] font-semibold text-tenue">€/L</p>
                    </div>
                    {mapa(e) && (
                      <a href={mapa(e)} target="_blank" rel="noopener nofollow"
                        class="shrink-0 rounded-lg border border-borde px-2 py-1 text-xs text-suave hover:text-acento"
                        aria-label={`Cómo llegar a ${e.rotulo}`}>Ir</a>
                    )}
                  </li>
                ))}
              </ol>
              <p class="mt-2 text-xs text-tenue">En verde las que están por debajo de la media local, en ámbar las que están por encima.</p>
            </section>
          </>
        )}

        <!-- Diésel del municipio -->
        {ga && ga.baratas.length > 1 && (
          <section class="px-4 pt-8">
            <h2 class="text-base font-bold text-tinta">Diésel en {muniNombre} por precio</h2>
            <ol class="mt-3 divide-y divide-borde rounded-2xl border border-borde bg-superficie">
              {ga.baratas.map((e, i) => (
                <li class="flex items-center gap-3 px-4 py-3">
                  <span class="w-5 shrink-0 text-sm font-bold text-tenue">{i + 1}</span>
                  <div class="min-w-0 flex-1">
                    <p class="truncate text-sm font-semibold text-tinta">{e.rotulo}</p>
                    {e.dir && <p class="truncate text-xs text-suave">{e.dir}</p>}
                  </div>
                  <div class="shrink-0 text-right">
                    <p class={`text-base font-bold ${colorPrecio(e.p.ga, ga.media)}`}>{p3(e.p.ga)}</p>
                    <p class="text-[10px] font-semibold text-tenue">€/L</p>
                  </div>
                </li>
              ))}
            </ol>
          </section>
        )}

        <!-- Donde esta mas barato cerca: la pregunta que la pagina de provincia no responde -->
        {cercanos.length > 0 && minAqui !== null && (
          <section class="px-4 pt-8">
            <h2 class="text-base font-bold text-tinta">Repostar cerca de {muniNombre}</h2>
            <p class="mt-2 text-sm leading-relaxed text-suave">
              {mejorCercano && ahorroCercano !== null ? (
                <>
                  La gasolina 95 más barata de {muniNombre} está a {p3(minAqui)} €/L.
                  A {km1(mejorCercano.km)} km, en {mejorCercano.nombre}, baja hasta
                  <strong class="text-barato">{p3(mejorCercano.minG95)} €/L</strong>:
                  unos {p2(ahorroCercano)} € menos por depósito. El desvío compensa si ya ibas
                  hacia allí.
                </>
              ) : (
                <>
                  La gasolina 95 más barata de {muniNombre} está a {p3(minAqui)} €/L, y ningún
                  municipio de alrededor la tiene más barata. Repostando aquí no pierdes nada.
                </>
              )}
            </p>
            <ul class="mt-3 divide-y divide-borde rounded-2xl border border-borde bg-superficie">
              {cercanos.map((c) => (
                <li class="flex items-center gap-3 px-4 py-3">
                  <div class="min-w-0 flex-1">
                    {c.slug ? (
                      <a href={`/gasolineras-baratas/${provSlug}/${c.slug}/`} class="truncate text-sm font-semibold text-tinta hover:text-acento">{c.nombre}</a>
                    ) : (
                      <p class="truncate text-sm font-semibold text-tinta">{c.nombre}</p>
                    )}
                    <p class="text-xs text-suave">a {km1(c.km)} km</p>
                  </div>
                  <div class="shrink-0 text-right">
                    <p class={c.minG95 < minAqui ? `text-base font-bold text-barato` : `text-base font-bold text-suave`}>{p3(c.minG95)}</p>
                    <p class="text-[10px] font-semibold text-tenue">€/L desde</p>
                  </div>
                </li>
              ))}
            </ul>
            <p class="mt-2 text-xs text-tenue">
              Municipios a menos de 35 km en línea recta, ordenados por precio. La distancia es
              entre centros aproximados, no por carretera.
            </p>
          </section>
        )}

        <!-- CTA al buscador -->
        <section class="px-4 pt-6">
          <a href={`/?prov=${prov.id}`}
            class="flex items-center justify-between gap-3 rounded-2xl border border-borde bg-superficie px-4 py-3.5 transition-colors hover:border-amber-500/50">
            <div>
              <p class="text-sm font-semibold text-tinta">Busca por cercanía en {prov.nombre}</p>
              <p class="text-xs text-suave">Precios en directo y ordenados por distancia a ti</p>
            </div>
            <span class="shrink-0 rounded-full bg-amber-500 px-3 py-1.5 text-xs font-semibold text-[#0B0D12]">Abrir</span>
          </a>
        </section>

        <!-- FAQ -->
        <section class="px-4 pt-8">
          <h2 class="text-base font-bold text-tinta">Preguntas frecuentes sobre las gasolineras de {muniNombre}</h2>
          <div class="mt-3 divide-y divide-borde">
            {faqs.map((f) => (
              <details class="group py-3">
                <summary class="flex cursor-pointer list-none items-center justify-between gap-3 text-sm font-medium text-tinta">
                  <span>{f.q}</span>
                  <span class="text-acento transition-transform group-open:rotate-45">+</span>
                </summary>
                <p class="mt-2 text-sm leading-relaxed text-suave">{f.a}</p>
              </details>
            ))}
          </div>
        </section>

        <!-- Otros municipios de la provincia -->
        {hermanos.length > 0 && (
          <section class="px-4 pt-8">
            <h2 class="text-base font-bold text-tinta">Otros municipios de {prov.nombre}</h2>
            <div class="mt-3 flex flex-wrap gap-x-3 gap-y-1.5">
              {hermanos.map((h) => (
                <a href={`/gasolineras-baratas/${provSlug}/${h.slug}/`} class="text-xs text-suave hover:text-acento">{h.nombre}</a>
              ))}
              <a href={`/gasolineras-baratas/${provSlug}/`} class="text-xs font-semibold text-acento hover:underline">Ver toda la provincia →</a>
            </div>
          </section>
        )}

        <footer class="px-4 pt-10 pb-8">
          <p class="text-xs leading-relaxed text-tenue">
            Los precios provienen del listado oficial del Ministerio (Geoportal Gasolineras) y
            corresponden a la última actualización indicada arriba. Pueden variar respecto al
            surtidor en el momento del repostaje. Ahorro al Volante es una herramienta informativa.
          </p>
          <div class="mt-4 flex flex-wrap gap-x-4 gap-y-1 text-xs">
            <a href="/" class="text-suave hover:text-acento">Inicio</a>
            <a href="/quienes-somos" class="text-suave hover:text-acento">Quiénes somos</a>
            <a href="/contacto" class="text-suave hover:text-acento">Contacto</a>
            <a href="/aviso-legal" class="text-suave hover:text-acento">Aviso legal</a>
            <a href="/privacidad" class="text-suave hover:text-acento">Privacidad</a>
            <a href="/cookies" class="text-suave hover:text-acento">Cookies</a>
          </div>
          <p class="mt-3 text-xs text-tenue">© {new Date().getFullYear()} Ahorro al Volante</p>
        </footer>
      </main>
    </div>
  </div>
</Layout>
