---
// Página por provincia. Se genera en el build con los precios oficiales del Ministerio,
// así el contenido (estaciones, medias y municipios) llega ya en el HTML y es indexable.
import Layout from '../../../layouts/Layout.astro';
import TendenciaPrecios from '../../../components/TendenciaPrecios.astro';
import { COMBUSTIBLES, PROVINCIAS, slugProvincia } from '../../../lib/gasolineras.js';
import { resumenPorProvincia } from '../../../lib/datos-build.js';
import historicoJson from '../../../data/historico.json';

const historico = historicoJson as {
  fechas: string[];
  nacional: Record<string, (number | null)[]>;
  provincias: Record<string, Record<string, (number | null)[]>>;
};

export async function getStaticPaths() {
  const resumenes = await resumenPorProvincia();
  return resumenes.map((datos) => ({ params: { provincia: datos.slug }, props: { datos } }));
}

interface Estacion {
  rotulo: string;
  dir: string;
  muni: string;
  horario: string;
  lat: number | null;
  lng: number | null;
  p: Record<string, number | null>;
}

interface ResumenCombustible {
  n: number;
  min: number;
  max: number;
  media: number;
  baratas: Estacion[];
}

interface MediaMunicipio {
  muni: string;
  n: number;
  media: number;
}

interface MunicipioPagina {
  nombre: string;
  slug: string;
  total: number;
}

interface Props {
  datos: {
    prov: { id: string; nombre: string };
    slug: string;
    fecha: string;
    total: number;
    combustibles: Record<string, ResumenCombustible | null>;
    municipiosBaratos: MediaMunicipio[];
    municipiosCaros: MediaMunicipio[];
    municipiosConPagina: MunicipioPagina[];
    todosLosMunicipios: {
      nombre: string;
      slug: string | null;
      total: number;
      minG95: number | null;
      mediaG95: number | null;
      minGa: number | null;
    }[];
  };
}

const { datos } = Astro.props;
const { prov, slug, fecha, total, combustibles, municipiosBaratos, municipiosCaros, municipiosConPagina, todosLosMunicipios } = datos;

const g95 = combustibles.g95;
const ga = combustibles.ga;

const DEPOSITO = 55; // litros, depósito tipo de un turismo
// Aceptan nulos porque no todas las estaciones sirven todos los combustibles.
const p3 = (n: number | null) => (n === null ? '-' : n.toFixed(3).replace('.', ','));
const p2 = (n: number | null) => (n === null ? '-' : n.toFixed(2).replace('.', ','));
const dia = (fecha || '').split(' ')[0];

const ahorroDeposito = g95 ? (g95.media - g95.min) * DEPOSITO : 0;

// Evolución histórica de esta provincia (si aún no hay datos, el componente no pinta nada).
const serieProv = historico.provincias?.[prov.id];
const seriesTendencia = serieProv
  ? [
      { id: 'g95', label: 'Gasolina 95', valores: serieProv.g95 ?? [] },
      { id: 'ga', label: 'Diésel', valores: serieProv.ga ?? [] },
    ]
  : [];
const mapa = (e: Estacion) =>
  e.lat && e.lng ? `https://www.google.com/maps/search/?api=1&query=${e.lat},${e.lng}` : null;

const title = `Gasolineras baratas en ${prov.nombre}: precios de hoy`;
const description = g95
  ? `Las gasolineras más baratas de ${prov.nombre} hoy: ${total} estaciones con precios oficiales del Ministerio. Gasolina 95 desde ${p3(g95.min)} €/L y media provincial de ${p3(g95.media)} €/L.`
  : `Precios de las ${total} gasolineras de ${prov.nombre} con datos oficiales del Ministerio, actualizados a diario.`;

const faqs: { q: string; a: string }[] = [];
if (g95) {
  faqs.push({
    q: `¿Cuál es la gasolinera más barata de ${prov.nombre}?`,
    a: `Según el listado oficial del ${dia}, la gasolina 95 más barata de ${prov.nombre} está en ${g95.baratas[0].rotulo} (${g95.baratas[0].muni}), a ${p3(g95.min)} € por litro. Los precios los fija cada estación y cambian a diario, así que conviene comprobarlos antes de salir.`,
  });
  faqs.push({
    q: `¿Cuánto cuesta llenar el depósito en ${prov.nombre}?`,
    a: `Con la media provincial de ${p3(g95.media)} €/L, llenar ${DEPOSITO} litros de gasolina 95 sale por unos ${p2(g95.media * DEPOSITO)} €. En la estación más barata de la provincia serían ${p2(g95.min * DEPOSITO)} €, es decir ${p2(ahorroDeposito)} € menos en un solo repostaje.`,
  });
}
if (municipiosBaratos.length > 1) {
  faqs.push({
    q: `¿En qué municipios de ${prov.nombre} está más barata la gasolina?`,
    a: `De media, los municipios más baratos de la provincia son ${municipiosBaratos.slice(0, 3).map((m) => m.muni).join(', ')}. La media se calcula solo con municipios que tienen al menos 3 estaciones, para que un único surtidor barato no distorsione el dato.`,
  });
}
faqs.push({
  q: '¿Cada cuánto se actualizan estos precios?',
  a: 'Las estaciones están obligadas por ley a comunicar sus precios al Ministerio, y el listado oficial se actualiza aproximadamente cada 30 minutos. Esta página se regenera a diario, y el buscador de la portada consulta los datos en directo cada vez que lo usas.',
});

const siteUrl = (Astro.site ?? new URL('https://ahorroalvolante.es')).href.replace(/\/$/, '');
const rutaCanonica = `/gasolineras-baratas/${slug}/`;

const grafo: Record<string, unknown>[] = [
  {
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Inicio', item: `${siteUrl}/` },
      {
        '@type': 'ListItem',
        position: 2,
        name: `Gasolineras baratas en ${prov.nombre}`,
        item: siteUrl + rutaCanonica,
      },
    ],
  },
  {
    '@type': 'FAQPage',
    mainEntity: faqs.map((f) => ({
      '@type': 'Question',
      name: f.q,
      acceptedAnswer: { '@type': 'Answer', text: f.a },
    })),
  },
];
// Lista ordenada de las gasolineras más baratas, para que Google entienda el ranking.
if (g95) {
  grafo.push({
    '@type': 'ItemList',
    name: `Gasolineras más baratas de ${prov.nombre} (gasolina 95)`,
    itemListOrder: 'https://schema.org/ItemListOrderAscending',
    numberOfItems: g95.baratas.length,
    itemListElement: g95.baratas.map((e, i) => ({
      '@type': 'ListItem',
      position: i + 1,
      name: `${e.rotulo} (${e.muni})`,
    })),
  });
}
const jsonLd = { '@context': 'https://schema.org', '@graph': grafo };

// Resto de provincias, para el enlazado interno.
const otras = PROVINCIAS.filter((p) => p.id !== prov.id).map((p) => ({
  nombre: p.nombre,
  slug: slugProvincia(p),
}));

const card = 'rounded-2xl border border-borde bg-superficie p-4';
// Verde por debajo de la media provincial, ámbar por encima.
const colorPrecio = (v: number | null, m: number) =>
  v !== null && v < m ? 'text-barato' : 'text-acento';
---
<Layout title={title} description={description} canonicalPath={rutaCanonica}>
  <script type="application/ld+json" slot="head" set:html={JSON.stringify(jsonLd)} />

  <div class="min-h-screen w-full bg-fondo">
    <div class="mx-auto flex max-w-5xl justify-center gap-8">
      <main class="w-full max-w-2xl">
        <!-- Migas -->
        <nav aria-label="Migas de pan" class="px-4 pt-6 text-xs text-tenue">
          <a href="/" class="hover:text-acento">Inicio</a>
          <span class="mx-1.5">/</span>
          <span class="text-suave">Gasolineras baratas en {prov.nombre}</span>
        </nav>

        <header class="px-4 pt-4">
          <h1 class="text-2xl font-bold tracking-tight text-tinta sm:text-3xl">
            Gasolineras baratas en <span class="text-acento">{prov.nombre}</span>
          </h1>
          <p class="mt-3 text-sm leading-relaxed text-suave">
            {g95 ? (
              <>
                Hemos revisado las <strong class="text-tinta">{total} gasolineras</strong> de
                {' '}{prov.nombre} en el listado oficial del Ministerio. Ahora mismo la gasolina 95
                más barata está a <strong class="text-barato">{p3(g95.min)} €/L</strong> en
                {' '}{g95.baratas[0].muni}, frente a una media provincial de
                {' '}<strong class="text-tinta">{p3(g95.media)} €/L</strong>.
              </>
            ) : (
              <>Precios de las {total} gasolineras de {prov.nombre} con datos oficiales del Ministerio.</>
            )}
          </p>
          <p class="mt-2 text-xs text-tenue">Datos oficiales del Ministerio. Actualizado el {fecha}.</p>
        </header>

        {g95 && (
          <>
            <!-- Cifras clave -->
            <section class="grid grid-cols-2 gap-3 px-4 pt-5">
              <div class={card}>
                <p class="text-xs font-semibold uppercase tracking-wide text-tenue">Media 95</p>
                <p class="mt-1 text-xl font-bold text-tinta">{p3(g95.media)} <span class="text-sm font-semibold text-suave">€/L</span></p>
              </div>
              <div class={card}>
                <p class="text-xs font-semibold uppercase tracking-wide text-tenue">Media diésel</p>
                <p class="mt-1 text-xl font-bold text-tinta">{ga ? p3(ga.media) : '-'} <span class="text-sm font-semibold text-suave">€/L</span></p>
              </div>
              <div class={card}>
                <p class="text-xs font-semibold uppercase tracking-wide text-tenue">95 más barata</p>
                <p class="mt-1 text-xl font-bold text-barato">{p3(g95.min)} <span class="text-sm font-semibold text-suave">€/L</span></p>
              </div>
              <div class={card}>
                <p class="text-xs font-semibold uppercase tracking-wide text-tenue">Ahorro al llenar</p>
                <p class="mt-1 text-xl font-bold text-acento">{p2(ahorroDeposito)} <span class="text-sm font-semibold text-suave">€</span></p>
              </div>
            </section>
            <p class="px-4 pt-2 text-xs leading-relaxed text-tenue">
              El ahorro compara repostar {DEPOSITO} litros en la estación más barata de la provincia
              en lugar de en una de precio medio.
            </p>

            <!-- Top gasolina 95 -->
            <section class="px-4 pt-8">
              <h2 class="text-base font-bold text-tinta">
                Las {g95.baratas.length} gasolineras más baratas de {prov.nombre} (gasolina 95)
              </h2>
              <ol class="mt-3 divide-y divide-borde rounded-2xl border border-borde bg-superficie">
                {g95.baratas.map((e, i) => (
                  <li class="flex items-center gap-3 px-4 py-3">
                    <span class="w-5 shrink-0 text-sm font-bold text-tenue">{i + 1}</span>
                    <div class="min-w-0 flex-1">
                      <p class="truncate text-sm font-semibold text-tinta">{e.rotulo}</p>
                      <p class="truncate text-xs text-suave">{e.muni}{e.dir ? ' · ' + e.dir : ''}</p>
                    </div>
                    <div class="shrink-0 text-right">
                      <p class={`text-base font-bold ${colorPrecio(e.p.g95, g95.media)}`}>{p3(e.p.g95)}</p>
                      <p class="text-[10px] font-semibold text-tenue">€/L</p>
                    </div>
                    {mapa(e) && (
                      <a href={mapa(e)} target="_blank" rel="noopener nofollow"
                        class="shrink-0 rounded-lg border border-borde px-2 py-1 text-xs text-suave hover:text-acento"
                        aria-label={`Cómo llegar a ${e.rotulo}`}>Ir</a>
                    )}
                  </li>
                ))}
              </ol>
            </section>
          </>
        )}

        <!-- CTA al buscador en directo -->
        <section class="px-4 pt-6">
          <a href={`/?prov=${prov.id}`}
            class="flex items-center justify-between gap-3 rounded-2xl border border-borde bg-superficie px-4 py-3.5 transition-colors hover:border-amber-500/50">
            <div>
              <p class="text-sm font-semibold text-tinta">Busca por cercanía en {prov.nombre}</p>
              <p class="text-xs text-suave">Precios en directo y ordenados por distancia a ti</p>
            </div>
            <span class="shrink-0 rounded-full bg-amber-500 px-3 py-1.5 text-xs font-semibold text-[#0B0D12]">Abrir</span>
          </a>
        </section>

        <TendenciaPrecios ambito={prov.nombre} fechas={historico.fechas} series={seriesTendencia} />

        <!-- Diésel -->
        {ga && (
          <section class="px-4 pt-8">
            <h2 class="text-base font-bold text-tinta">Diésel más barato en {prov.nombre}</h2>
            <ol class="mt-3 divide-y divide-borde rounded-2xl border border-borde bg-superficie">
              {ga.baratas.map((e, i) => (
                <li class="flex items-center gap-3 px-4 py-3">
                  <span class="w-5 shrink-0 text-sm font-bold text-tenue">{i + 1}</span>
                  <div class="min-w-0 flex-1">
                    <p class="truncate text-sm font-semibold text-tinta">{e.rotulo}</p>
                    <p class="truncate text-xs text-suave">{e.muni}{e.dir ? ' · ' + e.dir : ''}</p>
                  </div>
                  <div class="shrink-0 text-right">
                    <p class={`text-base font-bold ${colorPrecio(e.p.ga, ga.media)}`}>{p3(e.p.ga)}</p>
                    <p class="text-[10px] font-semibold text-tenue">€/L</p>
                  </div>
                </li>
              ))}
            </ol>
          </section>
        )}

        <!-- Medias por combustible -->
        <section class="px-4 pt-8">
          <h2 class="text-base font-bold text-tinta">Precio medio por combustible en {prov.nombre}</h2>
          <div class="mt-3 overflow-x-auto rounded-2xl border border-borde bg-superficie">
            <table class="w-full text-sm">
              <thead>
                <tr class="border-b border-borde text-left text-xs uppercase tracking-wide text-tenue">
                  <th class="px-4 py-2.5 font-semibold">Combustible</th>
                  <th class="px-4 py-2.5 text-right font-semibold">Más barata</th>
                  <th class="px-4 py-2.5 text-right font-semibold">Media</th>
                  <th class="px-4 py-2.5 text-right font-semibold">Estaciones</th>
                </tr>
              </thead>
              <tbody>
                {COMBUSTIBLES.map((c) => {
                  const d = combustibles[c.id];
                  return (
                    <tr class="border-b border-borde last:border-0">
                      <td class="px-4 py-2.5 text-tinta">{c.label}</td>
                      <td class="px-4 py-2.5 text-right font-semibold text-barato">{d ? p3(d.min) : '-'}</td>
                      <td class="px-4 py-2.5 text-right text-tinta">{d ? p3(d.media) : '-'}</td>
                      <td class="px-4 py-2.5 text-right text-suave">{d ? d.n : '-'}</td>
                    </tr>
                  );
                })}
              </tbody>
            </table>
          </div>
          <p class="mt-2 text-xs text-tenue">Precios en euros por litro. El GLP y el diésel premium no están disponibles en todas las estaciones.</p>
        </section>

        <!-- Municipios -->
        {municipiosBaratos.length > 1 && (
          <section class="px-4 pt-8">
            <h2 class="text-base font-bold text-tinta">Dónde repostar más barato en {prov.nombre}</h2>
            <div class="mt-3 grid gap-3 sm:grid-cols-2">
              <div class={card}>
                <p class="text-xs font-semibold uppercase tracking-wide text-barato">Municipios más baratos</p>
                <ul class="mt-2 space-y-1.5">
                  {municipiosBaratos.map((m) => (
                    <li class="flex justify-between gap-2 text-sm">
                      <span class="truncate text-tinta">{m.muni}</span>
                      <span class="shrink-0 font-semibold text-barato">{p3(m.media)}</span>
                    </li>
                  ))}
                </ul>
              </div>
              {municipiosCaros.length > 0 && (
                <div class={card}>
                  <p class="text-xs font-semibold uppercase tracking-wide text-acento">Municipios más caros</p>
                  <ul class="mt-2 space-y-1.5">
                    {municipiosCaros.map((m) => (
                      <li class="flex justify-between gap-2 text-sm">
                        <span class="truncate text-tinta">{m.muni}</span>
                        <span class="shrink-0 font-semibold text-acento">{p3(m.media)}</span>
                      </li>
                    ))}
                  </ul>
                </div>
              )}
            </div>
            <p class="mt-2 text-xs text-tenue">
              Media de gasolina 95 por municipio, contando solo los que tienen al menos 3 estaciones.
            </p>
          </section>
        )}

        <!-- Todos los municipios de la provincia, con precio. Los que no llegan al umbral
             de pagina propia (ver MIN_ESTACIONES_MUNICIPIO) publican aqui su dato: la
             informacion no se pierde, simplemente no gasta una URL casi vacia. -->
        {todosLosMunicipios.length > 0 && (
          <section class="px-4 pt-8">
            <h2 class="text-base font-bold text-tinta">La gasolina 95 municipio a municipio en {prov.nombre}</h2>
            <p class="mt-2 text-sm leading-relaxed text-suave">
              Precio más bajo de gasolina 95 en cada uno de los {todosLosMunicipios.length} municipios
              de {prov.nombre} con al menos una gasolinera en el listado oficial. Los
              municipios con suficientes estaciones para comparar tienen además su propia página.
            </p>
            <div class="mt-3 overflow-x-auto rounded-2xl border border-borde bg-superficie">
              <table class="w-full text-left text-sm">
                <thead class="border-b border-borde text-xs uppercase tracking-wide text-tenue">
                  <tr>
                    <th scope="col" class="px-4 py-2.5 font-semibold">Municipio</th>
                    <th scope="col" class="px-3 py-2.5 text-right font-semibold">Gasolineras</th>
                    <th scope="col" class="px-3 py-2.5 text-right font-semibold">95 desde</th>
                    <th scope="col" class="px-4 py-2.5 text-right font-semibold">Diésel desde</th>
                  </tr>
                </thead>
                <tbody class="divide-y divide-borde">
                  {todosLosMunicipios.map((m) => (
                    <tr>
                      <th scope="row" class="px-4 py-2.5 font-medium text-tinta">
                        {m.slug ? (
                          <a href={`/gasolineras-baratas/${slug}/${m.slug}/`} class="hover:text-acento">{m.nombre}</a>
                        ) : (
                          <span>{m.nombre}</span>
                        )}
                      </th>
                      <td class="px-3 py-2.5 text-right text-suave">{m.total}</td>
                      <td class="px-3 py-2.5 text-right font-semibold text-barato">{p3(m.minG95)}</td>
                      <td class="px-4 py-2.5 text-right font-semibold text-tinta">{p3(m.minGa)}</td>
                    </tr>
                  ))}
                </tbody>
              </table>
            </div>
            <p class="mt-2 text-xs text-tenue">
              Precios en €/L del listado oficial del Ministerio, actualizados el {fecha}.
            </p>
          </section>
        )}

        <!-- FAQ -->
        <section class="px-4 pt-8">
          <h2 class="text-base font-bold text-tinta">Preguntas frecuentes sobre las gasolineras de {prov.nombre}</h2>
          <div class="mt-3 divide-y divide-borde">
            {faqs.map((f) => (
              <details class="group py-3">
                <summary class="flex cursor-pointer list-none items-center justify-between gap-3 text-sm font-medium text-tinta">
                  <span>{f.q}</span>
                  <span class="text-acento transition-transform group-open:rotate-45">+</span>
                </summary>
                <p class="mt-2 text-sm leading-relaxed text-suave">{f.a}</p>
              </details>
            ))}
          </div>
        </section>

        <!-- Comparativas nacionales -->
        <section class="px-4 pt-8">
          <div class="grid gap-2">
            <a href="/marcas/" class="flex items-center justify-between gap-3 rounded-2xl border border-borde bg-superficie px-4 py-3.5 transition-colors hover:border-acento">
              <div>
                <p class="text-sm font-semibold text-tinta">¿Qué marca es más barata en España?</p>
                <p class="text-xs text-suave">Comparativa de todas las cadenas con el dato oficial</p>
              </div>
              <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"
                class="h-4 w-4 shrink-0 text-acento" aria-hidden="true">
                <polyline points="9 18 15 12 9 6" />
              </svg>
            </a>
            <a href="/precios/" class="flex items-center justify-between gap-3 rounded-2xl border border-borde bg-superficie px-4 py-3.5 transition-colors hover:border-acento">
              <div>
                <p class="text-sm font-semibold text-tinta">¿Cómo va {prov.nombre} frente al resto?</p>
                <p class="text-xs text-suave">Ranking de las 52 provincias por precio medio</p>
              </div>
              <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"
                class="h-4 w-4 shrink-0 text-acento" aria-hidden="true">
                <polyline points="9 18 15 12 9 6" />
              </svg>
            </a>
          </div>
        </section>

        <!-- Otras provincias -->
        <section class="px-4 pt-8">
          <h2 class="text-base font-bold text-tinta">Gasolineras baratas en otras provincias</h2>
          <div class="mt-3 flex flex-wrap gap-x-3 gap-y-1.5">
            {otras.map((p) => (
              <a href={`/gasolineras-baratas/${p.slug}/`} class="text-xs text-suave hover:text-acento">{p.nombre}</a>
            ))}
          </div>
        </section>

        <footer class="px-4 pt-10 pb-8">
          <p class="text-xs leading-relaxed text-tenue">
            Los precios provienen del listado oficial del Ministerio (Geoportal Gasolineras) y
            corresponden a la última actualización indicada arriba. Pueden variar respecto al
            surtidor en el momento del repostaje. Ahorro al Volante es una herramienta informativa.
          </p>
          <div class="mt-4 flex flex-wrap gap-x-4 gap-y-1 text-xs">
            <a href="/" class="text-suave hover:text-acento">Inicio</a>
            <a href="/quienes-somos" class="text-suave hover:text-acento">Quiénes somos</a>
            <a href="/contacto" class="text-suave hover:text-acento">Contacto</a>
            <a href="/aviso-legal" class="text-suave hover:text-acento">Aviso legal</a>
            <a href="/privacidad" class="text-suave hover:text-acento">Privacidad</a>
            <a href="/cookies" class="text-suave hover:text-acento">Cookies</a>
          </div>
          <p class="mt-3 text-xs text-tenue">© {new Date().getFullYear()} Ahorro al Volante</p>
        </footer>
      </main>
    </div>
  </div>
</Layout>
