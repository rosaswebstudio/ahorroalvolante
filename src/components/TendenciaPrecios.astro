---
// "¿Lleno hoy o espero?": evolución del precio medio y recomendación.
// Se calcula en el build a partir de src/data/historico.json: no lleva JavaScript.
import { analizar, veredicto, puntosSparkline } from '../lib/tendencia.js';

interface Props {
  ambito: string;              // "Madrid", "España"...
  fechas: string[];
  series: { id: string; label: string; valores: (number | null)[] }[];
}

const { ambito, fechas, series } = Astro.props;

const ANCHO = 300;
const ALTO = 60;

const analisis = series.map((s) => ({ ...s, a: analizar(s.valores), puntos: puntosSparkline(s.valores, ANCHO, ALTO) }));
const principal = analisis.find((s) => s.id === 'g95')?.a ?? analisis[0]?.a;
const v = veredicto(principal);

const p3 = (n: number) => n.toFixed(3).replace('.', ',');
const pct = (n: number) => (n >= 0 ? '+' : '') + (n * 100).toFixed(1).replace('.', ',') + '%';

// Los colores salen de variables CSS y no de hex fijos: esta sparkline se genera en el
// build, así que es la única forma de que siga el tema claro/oscuro del visitante.
const COLOR = {
  rojo: 'var(--serie-sube)',
  verde: 'var(--serie-baja)',
  neutro: 'var(--serie-neutro)',
} as Record<string, string>;
const colorV = v ? COLOR[v.color] : COLOR.neutro;

const dias = principal?.dias ?? 0;
const desde = fechas.length ? fechas[0].split('-').reverse().join('/') : '';
---
{v && principal && (
  <section class="px-4 pt-8">
    <h2 class="text-base font-bold text-tinta">¿Lleno hoy o espero? Precio en {ambito}</h2>

    <div class="mt-3 rounded-2xl border border-borde bg-superficie p-4">
      <div class="flex items-start gap-3">
        <span class="mt-0.5 h-10 w-1 shrink-0 rounded-full" style={`background-color:${colorV}`}></span>
        <div>
          <p class="text-base font-bold" style={`color:${colorV}`}>{v.titulo}</p>
          <p class="mt-1 text-sm leading-relaxed text-suave">{v.texto}</p>
        </div>
      </div>

      <div class="mt-4 grid gap-4 sm:grid-cols-2">
        {analisis.filter((s) => s.a).map((s) => (
          <div class="rounded-xl border border-borde bg-fondo p-3">
            <div class="flex items-baseline justify-between gap-2">
              <p class="text-xs font-semibold uppercase tracking-wide text-tenue">{s.label}</p>
              <p class="text-xs font-semibold" style={`color:${s.a!.cambio >= 0 ? COLOR.rojo : COLOR.verde}`}>
                {pct(s.a!.cambioPct)}
              </p>
            </div>
            <p class="mt-1 font-mono text-xl font-bold text-tinta">
              {p3(s.a!.actual)} <span class="text-xs font-semibold text-tenue">€/L</span>
            </p>
            <svg viewBox={`0 0 ${ANCHO} ${ALTO}`} preserveAspectRatio="none" class="mt-2 h-14 w-full" role="img"
              aria-label={`Evolución del precio de ${s.label} en ${ambito} en los últimos ${dias} días`}>
              <polyline points={s.puntos} fill="none"
                style={`stroke:${s.a!.cambio >= 0 ? COLOR.rojo : COLOR.verde}`}
                stroke-width="2" stroke-linejoin="round" stroke-linecap="round" vector-effect="non-scaling-stroke" />
            </svg>
            <div class="mt-1.5 flex justify-between text-[10px] text-tenue">
              <span>mín {p3(s.a!.minimo)}</span>
              <span>media {p3(s.a!.media)}</span>
              <span>máx {p3(s.a!.maximo)}</span>
            </div>
          </div>
        ))}
      </div>

      <p class="mt-3 text-[11px] leading-relaxed text-tenue">
        Media diaria de todas las gasolineras de {ambito}, desde el {desde} ({dias} días con datos del
        Ministerio). Es la evolución real de los precios, no una predicción: nadie puede saber qué hará
        el mercado mañana.
      </p>
    </div>
  </section>
)}
