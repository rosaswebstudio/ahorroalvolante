---
import { PROVINCIAS, COMBUSTIBLES } from '../lib/gasolineras.js';
const field = 'w-full rounded-lg border border-borde bg-fondo px-3 py-2 text-sm text-tinta outline-none focus:border-amber-500 focus:ring-2 focus:ring-amber-500/25';
---
<section id="buscador" class="scroll-mt-24">
  <div class="rounded-2xl border border-borde bg-superficie p-4 sm:p-6">
    <!-- Favoritos: se rellena desde localStorage, oculto si no hay ninguno -->
    <div id="gs-favs-box" class="mb-4 hidden">
      <div class="mb-2 flex items-baseline justify-between gap-2">
        <p class="text-xs font-semibold uppercase tracking-wide text-acento">Tus gasolineras</p>
        <span class="text-[11px] text-tenue">Guardadas en este dispositivo</span>
      </div>
      <div id="gs-favs" class="space-y-1.5"></div>

      <!-- Aviso de instalación: solo si hay favoritos que perder, la web no está
           instalada y el visitante no lo ha descartado antes. -->
      <div id="gs-instalar" class="mt-2 hidden rounded-xl border border-amber-500/30 bg-amber-500/5 px-3 py-2.5">
        <p class="text-xs leading-relaxed text-tinta">
          <strong class="text-acento">Para no perderlas: </strong>
          <span id="gs-instalar-texto"></span>
        </p>
        <div class="mt-2 flex items-center gap-2">
          <button id="gs-instalar-si" type="button"
            class="hidden rounded-lg bg-amber-500 px-3 py-1.5 text-xs font-semibold text-[#0B0D12] transition hover:bg-amber-400">
            Instalar la app
          </button>
          <button id="gs-instalar-no" type="button"
            class="rounded-lg px-2 py-1.5 text-xs font-medium text-suave transition hover:text-tinta">
            No, gracias
          </button>
        </div>
      </div>
    </div>

    <!-- Controles. En móvil, combustible y provincia van a dos columnas para que el
         municipio quepa sin empujar la lista de precios fuera de la pantalla. -->
    <div class="grid grid-cols-2 gap-3 sm:grid-cols-3">
      <label class="block">
        <span class="mb-1 block text-xs font-semibold uppercase tracking-wide text-suave">Combustible</span>
        <select id="gs-fuel" class={field}>
          {COMBUSTIBLES.map((c) => <option value={c.id}>{c.corto ?? c.label}</option>)}
        </select>
      </label>
      <label class="block">
        <span class="mb-1 block text-xs font-semibold uppercase tracking-wide text-suave">Provincia</span>
        <select id="gs-prov" class={field}>
          {PROVINCIAS.map((p) => <option value={p.id} selected={p.id === '28'}>{p.nombre}</option>)}
        </select>
      </label>
      <!-- Municipio. El <select> sigue siendo la fuente de verdad: guarda el valor y
           dispara los eventos que escucha el resto del buscador. Encima se monta un campo
           de texto que filtra, y que solo aparece si hay JavaScript. Barcelona tiene 87
           municipios y Valencia 70: desplegar esa lista en el móvil es incómodo, mientras
           que escribir "cárt" para llegar a Cártama es inmediato. -->
      <div class="col-span-2 sm:col-span-1">
        <label id="gs-muni-etiqueta" for="gs-muni" class="mb-1 block text-xs font-semibold uppercase tracking-wide text-suave">Municipio</label>
        <select id="gs-muni" class={field}>
          <option value="">Todos los municipios</option>
        </select>
        <div id="gs-muni-combo" class="relative" hidden>
          <input id="gs-muni-input" type="text" class={field} autocomplete="off" placeholder="Todos los municipios"
            role="combobox" aria-expanded="false" aria-controls="gs-muni-lista" aria-autocomplete="list" />
          <ul id="gs-muni-lista" role="listbox" aria-labelledby="gs-muni-etiqueta" hidden
            class="absolute inset-x-0 top-[calc(100%+4px)] z-30 max-h-60 overflow-y-auto rounded-lg border border-borde bg-superficie py-1 shadow-lg"></ul>
        </div>
      </div>
    </div>

    <div class="mt-3 flex flex-wrap items-center gap-2">
      <button id="gs-geo" type="button"
        class="inline-flex items-center gap-1.5 rounded-lg bg-amber-500 px-3 py-2 text-sm font-semibold text-[#0B0D12] transition hover:bg-amber-400">
        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="h-4 w-4"><path stroke-linecap="round" stroke-linejoin="round" d="M12 21s-7-5.1-7-11a7 7 0 1 1 14 0c0 5.9-7 11-7 11Z"/><circle cx="12" cy="10" r="2.5"/></svg>
        Cerca de mí
      </button>
      <div class="flex gap-1 rounded-lg border border-borde bg-fondo p-1 text-sm">
        <button id="gs-orden-precio" type="button" class="rounded-md px-3 py-1 font-medium">Más baratas</button>
        <button id="gs-orden-dist" type="button" class="rounded-md px-3 py-1 font-medium" disabled>Más cercanas</button>
        <button id="gs-orden-neto" type="button" class="rounded-md px-3 py-1 font-medium" disabled>Más rentables</button>
      </div>
      <!-- Litros del repostaje. El ahorro de irse a otra gasolinera es la diferencia de
           precio por los litros que eches, asi que sin este dato la cuenta del desvio no
           existe: dar por hecho un deposito lleno infla el numero para quien echa 20 L. -->
      <label class="inline-flex items-center gap-1.5 rounded-lg border border-borde bg-fondo px-2 py-1.5 text-sm text-suave">
        <span>Voy a echar</span>
        <select id="gs-litros" aria-label="Litros que vas a repostar" class="bg-transparent font-semibold text-tinta outline-none">
          <option value="20">20 L</option>
          <option value="30">30 L</option>
          <option value="40" selected>40 L</option>
          <option value="50">50 L</option>
          <option value="60">60 L</option>
        </select>
      </label>
      <!-- En móvil salta a su propia línea y la ocupa entera. Antes se iba a la derecha
           con `ml-auto` y dejaba un hueco vacío a su izquierda, como si faltara algo. -->
      <input id="gs-filtro" type="search" placeholder="Marca, calle…" aria-label="Buscar por marca o calle" class={`${field} max-w-none sm:ml-auto sm:max-w-56 sm:flex-1`} />
    </div>

    <p id="gs-status" class="mt-3 text-sm text-suave" aria-live="polite"></p>

    <!-- El navegador dice lo lejos que puede estar de acertar (coords.accuracy). En un movil
         con GPS son metros; en un escritorio resuelve por wifi o por IP y puede irse decenas
         de kilometros. Si no se avisa, el usuario ve "a 4,8 km" y se fia, que es peor que no
         dar el dato: todas las distancias estan desplazadas a la vez y parecen coherentes. -->
    <p id="gs-aviso-ubicacion" class="mt-2 hidden rounded-lg border border-amber-500/40 bg-amber-500/10 px-3 py-2 text-xs leading-relaxed text-suave"></p>

    <!-- Stats. Siempre en tres columnas: apiladas ocupaban media pantalla de móvil y
         empujaban la lista de gasolineras, que es lo que se viene a ver. -->
    <div id="gs-stats" class="mt-3 hidden grid-cols-3 gap-2">
      <div class="rounded-xl border border-borde bg-fondo px-2 py-2.5 sm:px-3 sm:py-3">
        <p class="text-[10px] uppercase tracking-wider text-suave sm:text-xs">Más barata</p>
        <p id="gs-min" class="mt-1 font-mono text-base font-semibold text-barato sm:text-lg">—</p>
      </div>
      <div class="rounded-xl border border-borde bg-fondo px-2 py-2.5 sm:px-3 sm:py-3">
        <p class="text-[10px] uppercase tracking-wider text-suave sm:text-xs">Media</p>
        <p id="gs-avg" class="mt-1 font-mono text-base font-semibold text-tinta sm:text-lg">—</p>
      </div>
      <div class="rounded-xl border border-borde bg-fondo px-2 py-2.5 sm:px-3 sm:py-3">
        <p class="text-[10px] uppercase tracking-wider text-suave sm:text-xs">Más cara</p>
        <p id="gs-max" class="mt-1 font-mono text-base font-semibold text-caro sm:text-lg">—</p>
      </div>
    </div>

    <!-- Lista -->
    <!-- Lista o mapa sobre los MISMOS datos ya filtrados: combustible, provincia, municipio
         y busqueda por texto valen para las dos vistas. Un mapa con otro criterio seria otra
         herramienta y habria que explicarla. -->
    <div class="mt-4 flex items-center justify-between gap-3">
      <div class="flex gap-1 rounded-lg border border-borde bg-fondo p-1 text-sm">
        <button id="gs-vista-lista" type="button" class="rounded-md px-3 py-1 font-medium">Lista</button>
        <button id="gs-vista-mapa" type="button" class="rounded-md px-3 py-1 font-medium">Mapa</button>
      </div>
    </div>

    <!-- El mapa se monta solo si se pide: Leaflet y sus teselas no se descargan mientras se
         use la lista, que es lo que hace casi todo el mundo y lo que ve el primer visitante. -->
    <div id="gs-mapa" class="mt-3 hidden h-[26rem] w-full overflow-hidden rounded-xl border border-borde sm:h-[32rem]"></div>
    <p id="gs-mapa-nota" class="mt-2 hidden text-[11px] leading-relaxed text-tenue"></p>

    <div id="gs-lista" class="mt-4 space-y-1.5"></div>
    <button id="gs-mas" type="button" class="mt-3 hidden w-full rounded-lg border border-borde px-4 py-2 text-sm font-medium text-tinta transition hover:border-suave">Mostrar más gasolineras</button>

    <!-- Los supuestos, a la vista. Un ahorro calculado sin decir sobre que se calcula es un
         numero bonito y nada mas; y si el lector no puede rehacer la cuenta, no se la cree. -->
    <p id="gs-nota-desvio" class="mt-3 hidden text-[11px] leading-relaxed text-tenue">
      El ahorro compara cada gasolinera con <strong class="text-suave">la más cercana a ti</strong>,
      que es la que usarías sin pensarlo. Descuenta el combustible del desvío contando ida y
      vuelta y un consumo de 7 L/100 km. La distancia es en línea recta corregida al alza, no una
      ruta calculada, así que tómala como una estimación: si la gasolinera te pilla de camino,
      ahorras más de lo que dice aquí.
    </p>

    <!-- Pie -->
    <div class="mt-4 flex items-center justify-between gap-3">
      <p id="gs-fuente" class="text-xs leading-snug text-suave">
        Precios oficiales del Ministerio (Geoportal Gasolineras).
      </p>
      <button id="gs-refresh" type="button" aria-label="Actualizar precios"
        class="rounded-full border border-borde bg-fondo p-2 text-suave transition hover:border-suave">
        <svg id="gs-refresh-icon" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="h-4 w-4"><polyline points="23 4 23 10 17 10"/><polyline points="1 20 1 14 7 14"/><path d="M3.51 9a9 9 0 0 1 14.85-3.36L23 10M1 14l4.64 4.36A9 9 0 0 0 20.49 15"/></svg>
      </button>
    </div>
  </div>
</section>

<script>
  import { cargarProvincia, distanciaKm, provinciaMasCercana, COMBUSTIBLES, leerPref, guardarPref } from '../lib/gasolineras.js';

  const $ = (id: string) => document.getElementById(id);
  const fuelSel = $('gs-fuel') as HTMLSelectElement;
  const provSel = $('gs-prov') as HTMLSelectElement;
  const muniSel = $('gs-muni') as HTMLSelectElement;
  const filtroInp = $('gs-filtro') as HTMLInputElement;
  const lista = $('gs-lista')!;
  const status = $('gs-status')!;
  const statsBox = $('gs-stats')!;
  const masBtn = $('gs-mas')!;
  const ordenPrecioBtn = $('gs-orden-precio') as HTMLButtonElement;
  const ordenDistBtn = $('gs-orden-dist') as HTMLButtonElement;
  const ordenNetoBtn = $('gs-orden-neto') as HTMLButtonElement;
  const litrosSel = $('gs-litros') as HTMLSelectElement;
  const mapaBox = $('gs-mapa')!;
  const mapaNota = $('gs-mapa-nota')!;
  const vistaListaBtn = $('gs-vista-lista') as HTMLButtonElement;
  const vistaMapaBtn = $('gs-vista-mapa') as HTMLButtonElement;
  const notaDesvio = $('gs-nota-desvio')!;
  const avisoUbicacion = $('gs-aviso-ubicacion')!;

  let data: any = null;
  let userPos: { lat: number; lng: number } | null = null;
  // Radio de error en metros que declara el navegador para userPos.
  let precisionM = 0;
  let orden: 'precio' | 'dist' | 'neto' = 'precio';
  let vista: 'lista' | 'mapa' = 'lista';
  // Contexto del mapa: null mientras no se haya pedido. Leaflet no se descarga hasta
  // entonces, asi que la portada no paga nada por una funcion que casi nadie abre.
  let ctxMapa: any = null;
  let montandoMapa = false;

  // Consumo de referencia para valorar el desvio, en L/100 km. Un turismo medio. No se
  // pregunta al usuario a proposito: el resultado apenas se mueve entre 6 y 8 L, y un campo
  // mas es una excusa para no usar la funcion.
  const CONSUMO_DESVIO = 7;
  // La distancia que sabemos calcular es en linea recta (haversine). Por carretera siempre
  // es mayor, y el factor que se usa habitualmente para aproximarla ronda 1,3. Es una
  // aproximacion y en la web se dice que lo es: no es una ruta calculada.
  const FACTOR_VIAL = 1.3;

  // Por encima de este error se avisa: las distancias siguen siendo coherentes entre si,
  // pero todas estan corridas lo mismo, asi que parecen bien y no lo estan.
  const PRECISION_AVISO = 1500;
  // Y por encima de este otro no se calcula el desvio: un ahorro construido sobre una
  // posicion que puede estar a diez kilometros no es una estimacion, es un numero al azar.
  const PRECISION_MAX = 10000;
  const LITROS_KEY = 'gs_litros';
  let visibles = 25;
  // Municipio guardado de la última visita: no se puede aplicar hasta que la provincia
  // haya cargado y sepamos qué municipios existen.
  let muniPendiente = '';

  // Escala de color del precio: verde (barato) -> ámbar -> rojo (caro). Los extremos se
  // leen del tema en vez de estar fijos aquí, porque los tonos claros que se ven bien
  // sobre negro no tienen contraste suficiente sobre blanco.
  let escala = [[52, 211, 153], [245, 158, 11], [248, 113, 113]];
  const hexRgb = (h: string) => {
    const s = h.trim().replace('#', '');
    if (!/^[0-9a-fA-F]{6}$/.test(s)) return null;
    return [0, 2, 4].map((i) => parseInt(s.slice(i, i + 2), 16));
  };
  const leerEscala = () => {
    const cs = getComputedStyle(document.documentElement);
    const c = [
      hexRgb(cs.getPropertyValue('--color-barato')),
      hexRgb(cs.getPropertyValue('--color-acento')),
      hexRgb(cs.getPropertyValue('--color-caro')),
    ];
    if (c.every(Boolean)) escala = c as number[][];
  };
  const lerp = (a: number[], b: number[], t: number) => a.map((v, i) => Math.round(v + (b[i] - v) * t));
  const colorFor = (t: number) => {
    const c = t < 0.5 ? lerp(escala[0], escala[1], t / 0.5) : lerp(escala[1], escala[2], (t - 0.5) / 0.5);
    return `rgb(${c.join(',')})`;
  };
  const norm = (s: string) => s.normalize('NFD').replace(/[̀-ͯ]/g, '').toLowerCase();
  const esc = (s: string) => s.replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;').replace(/"/g, '&quot;');
  const fmt = (n: number) => n.toLocaleString('es-ES', { minimumFractionDigits: 3, maximumFractionDigits: 3 });

  // Favoritos y preferencias: viven solo en este dispositivo, sin cuenta ni servidor.
  type Fav = { id: string; rotulo: string; muni: string; prov: string };
  const FAVS_KEY = 'gs_favs';
  const MAX_FAVS = 12;

  const leerFavs = (): Fav[] => {
    try {
      const v = JSON.parse(localStorage.getItem(FAVS_KEY) || '[]');
      return Array.isArray(v) ? v : [];
    } catch { return []; }
  };
  const guardarFavs = (l: Fav[]) => {
    try { localStorage.setItem(FAVS_KEY, JSON.stringify(l)); } catch { /* sin espacio */ }
  };

  const estrella = (activa: boolean) =>
    `<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" class="h-4 w-4" fill="${activa ? '#F59E0B' : 'none'}" stroke="${activa ? '#F59E0B' : 'currentColor'}" stroke-width="1.8"><path stroke-linejoin="round" d="M12 17.27 18.18 21l-1.64-7.03L22 9.24l-7.19-.61L12 2 9.19 8.63 2 9.24l5.46 4.73L5.82 21z"/></svg>`;

  const botonFav = (id: string, activa: boolean) => {
    const txt = activa ? 'Quitar de tus gasolineras' : 'Guardar en tus gasolineras';
    return `<button type="button" data-fav="${esc(id)}" aria-pressed="${activa}" aria-label="${txt}" title="${txt}" class="shrink-0 rounded-md border border-borde p-1.5 text-suave transition hover:border-amber-500 hover:text-acento">${estrella(activa)}</button>`;
  };

  // `hidden` y `grid` fijan las dos el display, así que hay que quitar una al poner la
  // otra: si no, al mostrarlas se quedaban en bloque y se apilaban.
  const mostrarStats = (v: boolean) => {
    statsBox.classList.toggle('hidden', !v);
    statsBox.classList.toggle('grid', v);
  };

  const setVista = (v: 'lista' | 'mapa') => {
    vista = v;
    const on = 'rounded-md px-3 py-1 font-medium bg-amber-500 text-[#0B0D12]';
    const off = 'rounded-md px-3 py-1 font-medium text-suave';
    vistaListaBtn.className = v === 'lista' ? on : off;
    vistaMapaBtn.className = v === 'mapa' ? on : off;
    mapaBox.classList.toggle('hidden', v !== 'mapa');
    mapaNota.classList.toggle('hidden', v !== 'mapa');
    lista.classList.toggle('hidden', v !== 'lista');
  };

  /** Monta Leaflet la primera vez que se pide el mapa y repinta. */
  async function abrirMapa() {
    if (montandoMapa) return;
    if (!ctxMapa) {
      montandoMapa = true;
      mapaNota.textContent = 'Cargando el mapa…';
      mapaNota.classList.remove('hidden');
      try {
        const mod = await import('../lib/mapa.js');
        ctxMapa = await mod.crearMapa(mapaBox);
        (ctxMapa as any).mod = mod;
      } catch {
        mapaNota.textContent = 'No se ha podido cargar el mapa. La lista sigue funcionando.';
        montandoMapa = false;
        setVista('lista');
        return;
      }
      montandoMapa = false;
    }
    setVista('mapa');
    // Leaflet mide el contenedor al crearse; si estaba oculto, midio cero.
    ctxMapa.mapa.invalidateSize();
    render();
  }

  const setOrden = (o: 'precio' | 'dist' | 'neto') => {
    orden = o;
    const on = 'rounded-md px-3 py-1 font-medium bg-amber-500 text-[#0B0D12]';
    const off = 'rounded-md px-3 py-1 font-medium text-suave';
    ordenPrecioBtn.className = o === 'precio' ? on : off;
    ordenDistBtn.className = o === 'dist' ? on : off;
    ordenNetoBtn.className = o === 'neto' ? on : off;
  };

  /**
   * Rellena el desplegable de municipios con los de la provincia cargada que venden el
   * combustible elegido, y el número de estaciones de cada uno. Se rellena aquí y no en
   * el build porque los datos ya están descargados: sale gratis y siempre está al día.
   */
  function rellenarMunicipios() {
    if (!data) return;
    const fuel = fuelSel.value;
    const elegido = muniPendiente || muniSel.value;
    muniPendiente = '';

    const cuenta = new Map<string, number>();
    let total = 0;
    for (const e of data.e) {
      if (!e.muni || e.p[fuel] == null) continue;
      cuenta.set(e.muni, (cuenta.get(e.muni) ?? 0) + 1);
      total++;
    }
    // Si el municipio elegido no vende este combustible, se queda en la lista con un (0)
    // en vez de desaparecer: así se entiende por qué no hay resultados.
    if (elegido && !cuenta.has(elegido)) cuenta.set(elegido, 0);

    const munis = [...cuenta.entries()].sort((a, b) => a[0].localeCompare(b[0], 'es'));
    muniSel.innerHTML =
      `<option value="">Todos los municipios (${total})</option>` +
      munis.map(([m, n]) => `<option value="${esc(m)}">${esc(m)} (${n})</option>`).join('');
    muniSel.value = elegido && cuenta.has(elegido) ? elegido : '';
    sincronizarCombo();
  }

  /**
   * Buscador de municipios montado encima del <select>. El desplegable nativo se queda
   * como fuente de verdad y como respaldo sin JavaScript: aquí solo se oculta. El filtro
   * ignora acentos (reusa `norm`), así que escribir "cart" encuentra Cártama.
   */
  const muniCombo = $('gs-muni-combo')!;
  const muniInput = $('gs-muni-input') as HTMLInputElement;
  const muniLista = $('gs-muni-lista')!;
  const muniEtiqueta = $('gs-muni-etiqueta') as HTMLLabelElement;
  let muniOpciones: { valor: string; texto: string }[] = [];
  let muniVisibles: { valor: string; texto: string }[] = [];
  let muniActivo = -1;

  const muniAbierto = () => !muniLista.hidden;

  /** Copia las opciones del <select>. No pisa el texto mientras está abierto: ahí lo
   *  escrito es la búsqueda del visitante, no el municipio ya elegido. */
  function sincronizarCombo() {
    muniOpciones = [...muniSel.options].map((o) => ({ valor: o.value, texto: o.textContent ?? '' }));
    muniInput.placeholder = muniOpciones[0]?.texto ?? 'Todos los municipios';
    if (muniAbierto()) return;
    const i = muniSel.selectedIndex;
    muniInput.value = i > 0 ? (muniSel.options[i].textContent ?? '') : '';
  }

  function marcarActivo(i: number) {
    muniActivo = i;
    const items = [...muniLista.querySelectorAll('li[data-valor]')] as HTMLElement[];
    items.forEach((li, n) => li.classList.toggle('bg-fondo', n === i));
    if (i >= 0 && items[i]) {
      muniInput.setAttribute('aria-activedescendant', items[i].id);
      items[i].scrollIntoView({ block: 'nearest' });
    } else {
      muniInput.removeAttribute('aria-activedescendant');
    }
  }

  function pintarLista(consulta: string) {
    const q = norm(consulta.trim());
    muniVisibles = q ? muniOpciones.filter((o) => norm(o.texto).includes(q)) : muniOpciones;
    if (!muniVisibles.length) {
      muniLista.innerHTML =
        '<li class="px-3 py-2 text-sm text-suave">Ningún municipio coincide con la búsqueda</li>';
      marcarActivo(-1);
      return;
    }
    muniLista.innerHTML = muniVisibles
      .map((o, i) =>
        `<li role="option" id="gs-muni-op-${i}" data-valor="${esc(o.valor)}"` +
        ` aria-selected="${o.valor === muniSel.value}"` +
        ` class="cursor-pointer px-3 py-2 text-sm text-tinta hover:bg-fondo">${esc(o.texto)}</li>`)
      .join('');
    marcarActivo(-1);
  }

  function abrirCombo() {
    pintarLista('');
    muniInput.select();
    muniLista.hidden = false;
    muniInput.setAttribute('aria-expanded', 'true');
  }

  function cerrarCombo() {
    muniLista.hidden = true;
    muniInput.setAttribute('aria-expanded', 'false');
    marcarActivo(-1);
    sincronizarCombo();
  }

  /** Escribe en el <select> y avisa: el resto del buscador ya escucha ese change. */
  function elegirMuni(valor: string) {
    muniSel.value = valor;
    cerrarCombo();
    muniSel.dispatchEvent(new Event('change'));
  }

  muniInput.addEventListener('focus', abrirCombo);
  muniInput.addEventListener('input', () => {
    pintarLista(muniInput.value);
    muniLista.hidden = false;
    muniInput.setAttribute('aria-expanded', 'true');
  });
  muniInput.addEventListener('keydown', (ev) => {
    if (ev.key === 'ArrowDown' || ev.key === 'ArrowUp') {
      ev.preventDefault();
      if (!muniAbierto()) { abrirCombo(); return; }
      const n = muniVisibles.length;
      if (!n) return;
      marcarActivo(ev.key === 'ArrowDown' ? (muniActivo + 1) % n : muniActivo <= 0 ? n - 1 : muniActivo - 1);
    } else if (ev.key === 'Enter' && muniAbierto() && muniActivo >= 0) {
      ev.preventDefault();
      elegirMuni(muniVisibles[muniActivo].valor);
    } else if (ev.key === 'Escape' && muniAbierto()) {
      ev.preventDefault();
      cerrarCombo();
    }
  });
  // mousedown y no click: con click, el input pierde antes el foco y la lista ya se ha
  // cerrado cuando llega el evento.
  muniLista.addEventListener('mousedown', (ev) => {
    const li = (ev.target as HTMLElement).closest('li[data-valor]') as HTMLElement | null;
    if (!li) return;
    ev.preventDefault();
    elegirMuni(li.dataset.valor ?? '');
  });
  document.addEventListener('click', (ev) => {
    if (muniAbierto() && !muniCombo.contains(ev.target as Node)) cerrarCombo();
  });

  // Se cambia aquí y no en el marcado: sin JavaScript se queda el <select>, que funciona.
  muniSel.hidden = true;
  muniCombo.hidden = false;
  muniEtiqueta.htmlFor = 'gs-muni-input';
  sincronizarCombo();

  function render() {
    if (!data) return;
    const fuel = fuelSel.value as 'g95' | 'ga' | 'g98' | 'gap' | 'glp';
    const filtro = norm(filtroInp.value.trim());
    const muni = muniSel.value;

    let l = data.e.filter((e: any) => e.p[fuel] != null);
    if (muni) l = l.filter((e: any) => e.muni === muni);
    if (filtro) l = l.filter((e: any) => norm(`${e.muni} ${e.loc} ${e.rotulo} ${e.dir}`).includes(filtro));
    if (userPos) l.forEach((e: any) => { e.dist = distanciaKm(userPos!.lat, userPos!.lng, e.lat, e.lng); });

    const fuelLabel = (COMBUSTIBLES.find((c) => c.id === fuel) || {}).label;

    if (l.length === 0) {
      lista.innerHTML = '';
      mostrarStats(false);
      masBtn.classList.add('hidden');
      notaDesvio.classList.add('hidden');
      avisoUbicacion.classList.add('hidden');
      status.textContent = muni
        ? `No hay gasolineras con ${fuelLabel} en ${muni}${filtro ? ' que coincidan con la búsqueda' : ''}.`
        : 'No hay gasolineras con ese combustible y filtro.';
      return;
    }

    let min = Infinity, max = -Infinity, sum = 0;
    l.forEach((e: any) => { const p = e.p[fuel]; if (p < min) min = p; if (p > max) max = p; sum += p; });
    ($('gs-min') as HTMLElement).textContent = fmt(min) + ' €';
    ($('gs-avg') as HTMLElement).textContent = fmt(sum / l.length) + ' €';
    ($('gs-max') as HTMLElement).textContent = fmt(max) + ' €';
    mostrarStats(true);

    // ¿Compensa moverse? La referencia es la gasolinera MAS CERCANA a ti de las que salen
    // en la lista, sea cara o barata: es la que usarias sin pensar, asi que es contra la que
    // hay que medir. Comparar contra la mas cercana "que ademas sea barata" perderia la
    // respuesta mas util, que es "quedate donde estas, ya tienes la mejor al lado".
    //
    // El coste del desvio se cuenta IDA Y VUELTA sobre los kilometros de MAS que hay que
    // hacer. Es la hipotesis conservadora: si la gasolinera te pilla de camino, el coste real
    // es menor y el ahorro que enseñamos se queda corto, que es el lado por el que hay que
    // equivocarse. La distancia es en linea recta, y por eso se corrige con un factor.
    const litros = Number(litrosSel.value) || 40;
    const posFiable = !!userPos && (precisionM === 0 || precisionM <= PRECISION_MAX);
    const conDist = posFiable ? l.filter((e: any) => Number.isFinite(e.dist)) : [];
    const ref = conDist.length ? conDist.reduce((a: any, b: any) => (b.dist < a.dist ? b : a)) : null;
    const neto = (e: any): number | null => {
      if (!ref || e.id === ref.id || !Number.isFinite(e.dist)) return null;
      const kmExtra = Math.max(0, e.dist - ref.dist) * FACTOR_VIAL * 2;
      const ahorro = (ref.p[fuel] - e.p[fuel]) * litros;
      const n = ahorro - ((kmExtra * CONSUMO_DESVIO) / 100) * e.p[fuel];
      return Number.isFinite(n) ? n : null;
    };
    if (ref) l.forEach((e: any) => { e.neto = neto(e); });

    l.sort((a: any, b: any) => {
      if (orden === 'dist' && userPos) return a.dist - b.dist;
      if (orden === 'neto' && ref) return (b.neto ?? 0) - (a.neto ?? 0);
      return a.p[fuel] - b.p[fuel];
    });

    const comoSeOrdena = orden === 'dist' ? 'cercanía' : orden === 'neto' && ref ? 'lo que te ahorras' : 'precio';
    status.textContent = `${l.length} gasolineras con ${fuelLabel}${muni ? ' en ' + muni : ''} · ordenadas por ${comoSeOrdena}`;

    // Media palabra de margen: por debajo de 30 centimos el resultado esta dentro del error
    // de estimar la distancia y el consumo, asi que decir "ahorras 12 centimos" seria fingir
    // una precision que no tenemos. Ahi se dice que se queda en nada, que es la verdad.
    const UMBRAL = 0.3;
    const euros = (n: number) => Math.abs(n).toLocaleString(`es-ES`, { minimumFractionDigits: 2, maximumFractionDigits: 2 });
    const textoDesvio = (e: any): string => {
      if (!ref) return '';
      if (e.id === ref.id) return 'La más cercana a ti.';
      const n = e.neto;
      if (n == null) return '';
      if (n > UMBRAL) return `Compensa: te ahorras ${euros(n)} € echando ${litros} L.`;
      if (n < -UMBRAL) return `No compensa: el desvío cuesta ${euros(n)} € más de lo que ahorras.`;
      return 'Se queda en nada: el desvío se lleva el ahorro.';
    };
    const lineaDesvio = (e: any) => {
      if (!ref) return ``;
      if (e.id === ref.id) return `<p class="text-[11px] leading-snug text-tenue">La más cercana a ti. Es la referencia de la comparación.</p>`;
      const n = e.neto;
      if (n == null) return ``;
      if (n > UMBRAL) return `<p class="text-[11px] font-semibold leading-snug text-barato">Compensa: te ahorras ${euros(n)} € echando ${litros} L, ya descontado el desvío.</p>`;
      if (n < -UMBRAL) return `<p class="text-[11px] leading-snug text-tenue">No compensa: el desvío te cuesta ${euros(n)} € más de lo que ahorras.</p>`;
      return `<p class="text-[11px] leading-snug text-tenue">Se queda en nada: lo que ahorras se lo lleva el desvío.</p>`;
    };
    const favIds = new Set(leerFavs().map((f) => f.id));
    lista.innerHTML = l.slice(0, visibles).map((e: any) => {
      const p = e.p[fuel];
      const t = max > min ? (p - min) / (max - min) : 0.5;
      const color = colorFor(t);
      const maps = `https://www.google.com/maps/dir/?api=1&destination=${e.lat},${e.lng}`;
      return `
      <!-- Dos filas a proposito. En una sola, el movil dejaba la columna del medio tan
           estrecha que cortaba la direccion y, peor, cortaba el ahorro: "Compensa: te aho..."
           esconde justo la cifra por la que existe la linea. Sacando "Cómo llegar" a su propia
           fila, el nombre y la direccion recuperan ancho y el ahorro se lee entero. -->
      <div class="rounded-xl border border-borde bg-fondo px-3 py-2.5">
        <div class="flex items-center gap-3">
          <div class="w-[4.5rem] shrink-0 text-center sm:w-20">
            <span class="font-mono text-base font-bold" style="color:${color}">${fmt(p)}</span>
            <span class="block text-[10px] text-tenue">€/litro</span>
          </div>
          <div class="min-w-0 flex-1">
            <p class="truncate text-sm font-semibold text-tinta">${esc(e.rotulo)}</p>
            <p class="truncate text-xs text-suave">${esc(e.dir)} · ${esc(e.loc || e.muni)}</p>
            ${e.horario ? `<p class="truncate text-[11px] text-tenue">${esc(e.horario)}</p>` : ''}
          </div>
          ${posFiable && Number.isFinite(e.dist) ? `<p class="shrink-0 font-mono text-xs text-suave">${e.dist < 10 ? e.dist.toFixed(1) : Math.round(e.dist)} km</p>` : ''}
          ${botonFav(e.id, favIds.has(e.id))}
        </div>
        <div class="mt-2 flex items-center justify-between gap-3">
          <div class="min-w-0 flex-1">${lineaDesvio(e)}</div>
          <a href="${maps}" target="_blank" rel="noopener nofollow" class="shrink-0 rounded-md border border-borde px-2 py-1 text-[11px] font-medium text-acento transition hover:border-amber-500">Cómo llegar</a>
        </div>
      </div>`;
    }).join('');

    notaDesvio.classList.toggle('hidden', !ref);

    // Tres estados de la ubicacion, y el tercero es el que faltaba. Un usuario no tiene forma
    // de saber que el navegador lo ha situado en otra ciudad: todas las distancias salen
    // coherentes entre si porque estan desplazadas lo mismo, asi que parecen correctas. Decir
    // desde donde se esta buscando convierte un error invisible en uno que se ve de un vistazo.
    // El margen se da con el numero que declara el navegador, no con adjetivos: "puede estar a
    // 12 km" se entiende y "ubicacion poco precisa" no dice nada.
    const AVISO = `mt-2 rounded-lg border px-3 py-2 text-xs leading-relaxed`;
    const radioTxt = precisionM >= 1000
      ? (precisionM / 1000).toLocaleString(`es-ES`, { maximumFractionDigits: 1 }) + ` km`
      : Math.round(precisionM) + ` m`;
    const dondeEstoy = ref ? esc(ref.loc || ref.muni || ``) : ``;

    if (userPos && !posFiable) {
      avisoUbicacion.className = AVISO + ` border-amber-500/40 bg-amber-500/10 text-suave`;
      avisoUbicacion.innerHTML = `Tu navegador no sabe dónde estás con suficiente precisión (margen de <strong class="text-tinta">${radioTxt}</strong>), así que no se calcula el ahorro del desvío: saldría un número al azar. Elige tu municipio en el desplegable de arriba.`;
    } else if (userPos && ref && precisionM > PRECISION_AVISO) {
      avisoUbicacion.className = AVISO + ` border-amber-500/40 bg-amber-500/10 text-suave`;
      avisoUbicacion.innerHTML = `Buscando desde tu ubicación, que el navegador sitúa <strong class="text-tinta">cerca de ${dondeEstoy}</strong> con un margen de ${radioTxt}. Si no es ahí donde estás, elige tu municipio arriba: en un ordenador la ubicación se calcula por wifi y falla con facilidad.`;
    } else if (userPos && ref) {
      avisoUbicacion.className = AVISO + ` border-borde bg-fondo text-tenue`;
      avisoUbicacion.innerHTML = `Buscando desde tu ubicación, <strong class="text-suave">cerca de ${dondeEstoy}</strong>. ¿No es ahí donde estás? Elige tu municipio en el desplegable de arriba.`;
    } else {
      avisoUbicacion.className = AVISO + ` hidden`;
    }

    masBtn.classList.toggle('hidden', vista !== 'lista' || l.length <= visibles);

    if (vista === 'mapa' && ctxMapa) {
      const r = (ctxMapa as any).mod.pintarMapa(
        ctxMapa, l, fuel, min, max,
        { colorFor, fmt, esc, textoDesvio },
        posFiable ? userPos : null,
      );
      mapaNota.textContent = r.pintados < r.total
        ? `Mostrando ${r.pintados} de ${r.total} gasolineras, las primeras del orden elegido. Afina con el municipio o la búsqueda para verlas todas.`
        : `${r.total} gasolineras en el mapa. Toca una chincheta para ver la dirección y si te compensa.`;
    }
  }

  async function load(force = false) {
    status.textContent = 'Cargando precios…';
    $('gs-refresh-icon')!.classList.add('spin');
    lista.innerHTML = '';
    masBtn.classList.add('hidden');
    notaDesvio.classList.add('hidden');
    try {
      data = await cargarProvincia(provSel.value, force);
      ($('gs-fuente') as HTMLElement).textContent =
        `Precios oficiales del Ministerio (Geoportal Gasolineras)${data.fecha ? ' · Actualizado: ' + data.fecha : ''}`;
      visibles = 25;
      rellenarMunicipios();
      render();
      // Se mide aquí y en el cambio de combustible, no en cada render: si no, teclear en
      // el buscador dispararía un evento por letra.
      (window as any).gtag?.('event', 'fuel_prices_checked', { prov: provSel.value, fuel: fuelSel.value });
    } catch {
      status.textContent = 'No se han podido cargar los precios. Comprueba tu conexión e inténtalo de nuevo.';
    } finally {
      $('gs-refresh-icon')!.classList.remove('spin');
    }
  }

  /** Pinta el bloque de favoritos con el precio de hoy del combustible elegido. */
  async function renderFavoritos() {
    const favs = leerFavs();
    const box = $('gs-favs-box')!;
    const cont = $('gs-favs')!;
    if (!favs.length) { box.classList.add('hidden'); cont.innerHTML = ''; return; }
    box.classList.remove('hidden');
    renderAvisoInstalar(true);

    const fuel = fuelSel.value;
    // Los favoritos pueden estar en provincias distintas a la que se está viendo.
    const porProv = new Map<string, Map<string, any>>();
    await Promise.all([...new Set(favs.map((f) => f.prov))].map(async (p) => {
      try {
        const d = await cargarProvincia(p);
        porProv.set(p, new Map(d.e.map((e: any) => [e.id, e])));
      } catch { /* si falla una provincia, esas filas se quedan sin precio */ }
    }));

    const fuelLabel = (COMBUSTIBLES.find((c) => c.id === fuel) || {}).label || '';
    cont.innerHTML = favs.map((f) => {
      const est = porProv.get(f.prov)?.get(f.id);
      const p = est?.p?.[fuel];
      const precio = p != null
        ? `<span class="font-mono text-base font-bold text-acento">${fmt(p)}</span><span class="block text-[10px] text-tenue">€/litro</span>`
        : `<span class="text-[11px] leading-tight text-tenue">sin ${esc(fuelLabel)}</span>`;
      const maps = est?.lat ? `https://www.google.com/maps/dir/?api=1&destination=${est.lat},${est.lng}` : '';
      return `
      <div class="flex items-center gap-3 rounded-xl border border-amber-500/25 bg-fondo px-3 py-2.5">
        <div class="w-20 shrink-0 text-center">${precio}</div>
        <div class="min-w-0 flex-1">
          <p class="truncate text-sm font-semibold text-tinta">${esc(f.rotulo)}</p>
          <p class="truncate text-xs text-suave">${esc(f.muni)}</p>
        </div>
        ${maps ? `<a href="${maps}" target="_blank" rel="noopener nofollow" class="shrink-0 rounded-md border border-borde px-2 py-1 text-[11px] font-medium text-acento transition hover:border-amber-500">Cómo llegar</a>` : ''}
        ${botonFav(f.id, true)}
      </div>`;
    }).join('');
  }

  // --- Aviso de instalación -------------------------------------------------
  // En iOS, Safari borra el almacenamiento local tras 7 días sin visitar la web,
  // pero las apps añadidas a la pantalla de inicio están exentas. Como se reposta
  // cada una o dos semanas, sin instalar se perderían justo entre repostajes.
  const INSTALL_KEY = 'gs_install_no';

  const yaInstalada = () =>
    window.matchMedia('(display-mode: standalone)').matches ||
    (navigator as any).standalone === true;

  // iPadOS se hace pasar por Mac, de ahí la comprobación táctil.
  const esIOS = () =>
    /iphone|ipod|ipad/i.test(navigator.userAgent) ||
    (navigator.platform === 'MacIntel' && navigator.maxTouchPoints > 1);

  function renderAvisoInstalar(hayFavoritos: boolean) {
    const caja = $('gs-instalar')!;
    const descartado = (() => {
      try { return localStorage.getItem(INSTALL_KEY) === '1'; } catch { return false; }
    })();
    if (!hayFavoritos || descartado || yaInstalada()) {
      caja.classList.add('hidden');
      return;
    }
    const prompt = (window as any).__instalable;
    const texto = $('gs-instalar-texto')!;
    const btnSi = $('gs-instalar-si')!;

    if (esIOS()) {
      texto.textContent =
        'en iPhone, el navegador borra lo guardado si pasas una semana sin entrar. Añade la web a tu pantalla de inicio: pulsa Compartir y luego "Añadir a pantalla de inicio".';
      btnSi.classList.add('hidden');
    } else if (prompt) {
      texto.textContent =
        'instala la web como app y tus gasolineras dejarán de depender de la limpieza del navegador.';
      btnSi.classList.remove('hidden');
    } else {
      texto.textContent =
        'añade la web a tu pantalla de inicio desde el menú del navegador y tus gasolineras no dependerán de su limpieza.';
      btnSi.classList.add('hidden');
    }
    caja.classList.remove('hidden');
  }

  $('gs-instalar-no')!.addEventListener('click', () => {
    try { localStorage.setItem(INSTALL_KEY, '1'); } catch { /* sin espacio */ }
    $('gs-instalar')!.classList.add('hidden');
  });

  $('gs-instalar-si')!.addEventListener('click', async () => {
    const prompt = (window as any).__instalable;
    if (!prompt) return;
    $('gs-instalar')!.classList.add('hidden');
    prompt.prompt();
    try {
      await prompt.userChoice;
    } finally {
      (window as any).__instalable = null;
    }
  });

  // El evento puede llegar después de pintar los favoritos.
  window.addEventListener('gs:instalable', () => renderAvisoInstalar(leerFavs().length > 0));

  // Los precios llevan el color en un atributo de estilo, así que al cambiar de tema hay
  // que releer la escala y repintar: el CSS solo no puede hacerlo.
  window.addEventListener('gs:tema', () => {
    leerEscala();
    render();
    renderFavoritos();
  });

  function toggleFav(id: string) {
    const favs = leerFavs();
    const i = favs.findIndex((f) => f.id === id);
    if (i >= 0) {
      favs.splice(i, 1);
    } else {
      const e = data?.e.find((x: any) => x.id === id);
      if (!e) return;
      if (favs.length >= MAX_FAVS) {
        status.textContent = `Solo puedes guardar ${MAX_FAVS} gasolineras. Quita alguna para añadir otra.`;
        return;
      }
      favs.push({ id, rotulo: e.rotulo, muni: e.loc || e.muni, prov: provSel.value });
    }
    guardarFavs(favs);
    render();
    renderFavoritos();
  }

  // Delegación: la estrella aparece tanto en la lista como en el bloque de favoritos.
  $('buscador')!.addEventListener('click', (ev) => {
    const btn = (ev.target as HTMLElement).closest('[data-fav]') as HTMLElement | null;
    if (btn?.dataset.fav) toggleFav(btn.dataset.fav);
  });

  fuelSel.addEventListener('change', () => {
    visibles = 25;
    guardarPref({ fuel: fuelSel.value });
    rellenarMunicipios();
    render();
    renderFavoritos();
    (window as any).gtag?.('event', 'fuel_prices_checked', { prov: provSel.value, fuel: fuelSel.value });
  });
  provSel.addEventListener('change', () => {
    userPos = null;
    ordenDistBtn.disabled = true;
    ordenNetoBtn.disabled = true;
    setOrden('precio');
    // El municipio pertenece a la provincia anterior: no tiene sentido conservarlo.
    muniSel.value = '';
    sincronizarCombo();
    guardarPref({ prov: provSel.value, muni: '' });
    load();
  });
  muniSel.addEventListener('change', () => {
    visibles = 25;
    guardarPref({ muni: muniSel.value });
    render();
  });
  filtroInp.addEventListener('input', () => { visibles = 25; render(); });
  ordenPrecioBtn.addEventListener('click', () => { setOrden('precio'); render(); });
  ordenDistBtn.addEventListener('click', () => { if (userPos) { setOrden('dist'); render(); } });
  ordenNetoBtn.addEventListener('click', () => { if (userPos) { setOrden('neto'); render(); } });

  setVista('lista');

  vistaListaBtn.addEventListener('click', () => { setVista('lista'); render(); });
  vistaMapaBtn.addEventListener('click', () => { abrirMapa(); });

  // Los litros cambian el ahorro de forma proporcional, asi que se recuerdan: quien echa
  // siempre 30 L no tiene que volver a decirlo en cada visita.
  try { const g = localStorage.getItem(LITROS_KEY); if (g) litrosSel.value = g; } catch { /* sin acceso */ }
  litrosSel.addEventListener('change', () => {
    try { localStorage.setItem(LITROS_KEY, litrosSel.value); } catch { /* sin espacio */ }
    render();
  });
  masBtn.addEventListener('click', () => { visibles += 25; render(); });
  $('gs-refresh')!.addEventListener('click', () => load(true));

  $('gs-geo')!.addEventListener('click', () => {
    if (!('geolocation' in navigator)) { status.textContent = 'Tu navegador no permite la geolocalización.'; return; }
    status.textContent = 'Obteniendo tu ubicación…';

    // Por que no basta con getCurrentPosition: devuelve UNA foto, la primera que cumpla las
    // opciones dentro del timeout. Si el GPS todavia no ha fijado (y tarda segundos), esa foto
    // es la de la red, con error de kilometros. Las apps de mapas no hacen eso: se suscriben y
    // van refinando segun mejora la señal. Aqui se hace lo mismo durante unos segundos y nos
    // quedamos siempre con la mejor lectura, repintando cuando mejora de verdad.
    let mejor = Infinity;
    let primera = true;
    let watchId = 0;
    // Si la primera lectura entra antes de que watchPosition haya devuelto su id, parar() no
    // tendria nada que limpiar y el GPS se quedaria abierto. Se anota y se limpia despues.
    let debeParar = false;
    const parar = () => {
      if (watchId) { navigator.geolocation.clearWatch(watchId); watchId = 0; }
      else debeParar = true;
    };

    const usar = async (pos: GeolocationPosition) => {
      const acc = Number.isFinite(pos.coords.accuracy) ? pos.coords.accuracy : Infinity;
      // Solo se acepta una lectura si mejora la anterior en algo apreciable: si no, cada
      // actualizacion del GPS repintaria la lista y saltaria bajo el dedo.
      if (!primera && acc > mejor * 0.8) return;
      mejor = acc;
      userPos = { lat: pos.coords.latitude, lng: pos.coords.longitude };
      precisionM = Number.isFinite(acc) ? acc : 0;

      if (primera) {
        primera = false;
        ordenDistBtn.disabled = false;
        ordenNetoBtn.disabled = false;
        setOrden('neto');
        // Ordenar por cercanía dentro de un solo municipio no tiene sentido: se quita
        // el filtro para que salgan también las de los pueblos de al lado.
        muniSel.value = '';
        sincronizarCombo();
        guardarPref({ muni: '' });
      }

      // Con 100 m ya no hay nada que ganar para esto: la decision es entre gasolineras que
      // estan a kilometros unas de otras.
      if (acc <= 100) parar();

      const prov = provinciaMasCercana(userPos.lat, userPos.lng);
      if (prov.id !== provSel.value) { provSel.value = prov.id; await load(); }
      else render();
    };

    watchId = navigator.geolocation.watchPosition(
      usar,
      () => {
        parar();
        if (primera) status.textContent = 'No se pudo obtener tu ubicación (permiso denegado o conexión no segura). Elige provincia manualmente.';
      },
      { enableHighAccuracy: true, timeout: 15000, maximumAge: 0 }
    );
    if (debeParar) parar();
    // Techo de tiempo: pasados 12 s nos quedamos con lo que haya. Mantener el GPS abierto
    // gasta bateria y a partir de ahi ya no suele mejorar.
    setTimeout(parar, 12000);
  });

  // Preferencias de la última visita (combustible y provincia).
  const pref = leerPref();
  const existe = (sel: HTMLSelectElement, v: string) => Array.from(sel.options).some((o) => o.value === v);
  if (pref.fuel && existe(fuelSel, pref.fuel)) fuelSel.value = pref.fuel;
  if (pref.prov && existe(provSel, pref.prov)) provSel.value = pref.prov;
  if (pref.muni) muniPendiente = pref.muni;

  // Las páginas de provincia enlazan aquí con ?prov=28: manda sobre lo guardado.
  const provParam = new URLSearchParams(location.search).get('prov');
  if (provParam && existe(provSel, provParam)) provSel.value = provParam;
  // Si llegamos a otra provincia, el municipio guardado ya no pertenece a ella.
  if (provParam && provParam !== pref.prov) muniPendiente = '';

  leerEscala();
  setOrden('precio');
  load();
  renderFavoritos();
</script>
