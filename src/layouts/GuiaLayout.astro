---
// Layout de una guía. Todo lo que no es el texto en sí (cabecera, fecha, guías
// relacionadas, datos estructurados) sale de aquí, así que cada página de guía se queda
// solo con su contenido.
import Layout from './Layout.astro';
import { guia, rutaGuia, otrasGuias, fechaLarga } from '../lib/guias.js';

interface Props {
  slug: string;
}

const { slug } = Astro.props;
const g = guia(slug);
const relacionadas = otrasGuias(slug);
const ruta = rutaGuia(slug);
const siteUrl = (Astro.site ?? new URL('https://ahorroalvolante.es')).href.replace(/\/$/, '');

// Article, no BlogPosting: no es un blog con actualidad, son páginas de referencia que se
// revisan. `dateModified` es la fecha real de revisión que hay en guias.js.
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Article',
  headline: g.titulo,
  description: g.description,
  inLanguage: 'es-ES',
  datePublished: g.actualizada,
  dateModified: g.actualizada,
  mainEntityOfPage: { '@type': 'WebPage', '@id': `${siteUrl}${ruta}` },
  author: { '@type': 'Organization', name: 'Ahorro al Volante', url: `${siteUrl}/quienes-somos/` },
  publisher: { '@type': 'Organization', name: 'Ahorro al Volante', url: siteUrl },
};
---
<Layout title={`${g.titulo} | Ahorro al Volante`} description={g.description} canonicalPath={ruta}>
  <script type="application/ld+json" slot="head" set:html={JSON.stringify(jsonLd)} />

  <div class="min-h-screen w-full" style="background-color:var(--color-fondo);">
    <div class="mx-auto max-w-2xl px-4 py-8">

      <nav aria-label="Migas" class="flex flex-wrap items-center gap-1 text-xs text-tenue">
        <a href="/" class="hover:text-acento">Inicio</a>
        <span aria-hidden="true">/</span>
        <a href="/guias/" class="hover:text-acento">Guías</a>
      </nav>

      <article class="guia mt-5">
        <p class="text-xs font-semibold uppercase tracking-[0.16em] text-acento">{g.tema}</p>
        <h1 class="mt-2">{g.titulo}</h1>
        <p class="entradilla">{g.resumen}</p>
        <p class="mt-3 text-xs text-tenue">
          Revisada el {fechaLarga(g.actualizada)} · {g.minutos} min de lectura
        </p>
        <hr class="mt-6 border-0 border-t" style="border-color:var(--color-borde);" />

        <slot />
      </article>

      <aside class="mt-12 border-t pt-6" style="border-color:var(--color-borde);">
        <h2 class="text-sm font-bold text-tinta">Seguir leyendo</h2>
        <ul class="mt-3 grid gap-2">
          {relacionadas.map((r) => (
            <li>
              <a href={rutaGuia(r.slug)}
                class="block rounded-xl border p-3 transition-colors hover:border-suave"
                style="border-color:var(--color-borde);background-color:var(--color-superficie);">
                <span class="block text-sm font-semibold text-tinta">{r.titulo}</span>
                <span class="mt-1 block text-xs leading-relaxed text-suave">{r.resumen}</span>
              </a>
            </li>
          ))}
        </ul>
        <p class="mt-4 text-xs">
          <a href="/guias/" class="text-acento hover:underline">Ver todas las guías →</a>
        </p>
      </aside>

      <footer class="mt-10 border-t pt-6" style="border-color:var(--color-borde);">
        <p class="text-xs leading-relaxed text-tenue">
          Guía informativa de Ahorro al Volante. Los precios de carburante salen del listado oficial del
          Ministerio y cambian a diario; las cifras de consumo son valores de referencia, no medidas
          de tu coche. No es asesoramiento de ningún tipo.
        </p>
        <div class="mt-4 flex flex-wrap gap-x-4 gap-y-1 text-xs">
          <a href="/" class="text-suave hover:text-acento">Buscador de gasolineras</a>
          <a href="/guias/" class="text-suave hover:text-acento">Guías</a>
          <a href="/quienes-somos" class="text-suave hover:text-acento">Quiénes somos</a>
          <a href="/contacto" class="text-suave hover:text-acento">Contacto</a>
          <a href="/privacidad" class="text-suave hover:text-acento">Privacidad</a>
        </div>
        <p class="mt-3 text-xs text-tenue">© {new Date().getFullYear()} Ahorro al Volante</p>
      </footer>
    </div>
  </div>
</Layout>

<style is:global>
  /* Tipografía de lectura larga. Medidas en rem para que respete el tamaño de letra del
     navegador: en una página que se lee entera, eso importa. */
  .guia h1 { color: var(--color-tinta); font-size: 1.75rem; font-weight: 800; line-height: 1.2; letter-spacing: -0.02em; }
  .guia .entradilla { color: var(--color-suave); font-size: 1.0625rem; line-height: 1.6; margin-top: 0.85rem; }
  .guia h2 { color: var(--color-tinta); font-size: 1.25rem; font-weight: 700; line-height: 1.3; margin-top: 2.5rem; letter-spacing: -0.01em; }
  .guia h3 { color: var(--color-tinta); font-size: 1rem; font-weight: 700; margin-top: 1.75rem; }
  .guia p { color: var(--color-suave); font-size: 1rem; line-height: 1.75; margin-top: 1rem; }
  .guia ul, .guia ol { margin-top: 1rem; padding-left: 1.35rem; }
  .guia ul { list-style: disc; }
  .guia ol { list-style: decimal; }
  .guia li { color: var(--color-suave); font-size: 1rem; line-height: 1.7; margin-top: 0.45rem; }
  .guia li::marker { color: var(--color-tenue); }
  .guia strong { color: var(--color-tinta); font-weight: 600; }
  .guia a { color: var(--color-acento); text-decoration: underline; text-underline-offset: 2px; }

  /* Bloque destacado: una idea que se puede leer suelta sin haber leído el párrafo. */
  .guia .clave {
    margin-top: 1.5rem; border-left: 3px solid var(--color-acento);
    background: var(--color-superficie); border-radius: 0 0.75rem 0.75rem 0;
    padding: 0.9rem 1.1rem;
  }
  .guia .clave p { margin-top: 0; color: var(--color-tinta); font-size: 0.95rem; }
  .guia .clave p + p { margin-top: 0.6rem; color: var(--color-suave); }

  .guia figure { margin: 1.5rem 0 0; }
  .guia figcaption { color: var(--color-tenue); font-size: 0.75rem; line-height: 1.5; margin-top: 0.5rem; }

  .guia table { width: 100%; border-collapse: collapse; margin-top: 1.25rem; font-size: 0.875rem; }
  .guia th, .guia td { border: 1px solid var(--color-borde); padding: 0.55rem 0.7rem; color: var(--color-suave); text-align: left; }
  .guia th { color: var(--color-tinta); background: var(--color-superficie); font-weight: 600; }
  .guia td.num, .guia th.num { text-align: right; font-family: "JetBrains Mono", ui-monospace, monospace; }
  /* Una tabla ancha no puede empujar la página entera en un móvil. */
  .guia .tabla-scroll { overflow-x: auto; margin-top: 1.25rem; }
  .guia .tabla-scroll table { margin-top: 0; }

  .guia .fuentes { margin-top: 2.5rem; border-top: 1px solid var(--color-borde); padding-top: 1.25rem; }
  .guia .fuentes h2 { font-size: 0.9rem; margin-top: 0; }
  .guia .fuentes li, .guia .fuentes p { font-size: 0.8125rem; line-height: 1.6; color: var(--color-tenue); }
</style>
